{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "bohtreinar",
  "main": "worker/src/index.js",
  "compatibility_date": "2026-10-01",
  "workers_dev": true,
  "preview_urls": false,
  "assets": {
    "directory": "./build",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "vars": {
    "FIREBASE_PROJECT_ID": "workout-tracker-app-20e43",
    "ALLOWED_ORIGINS": "https://workout-tracker-app-20e43.web.app,https://workout-tracker-app-20e43.firebaseapp.com"
  }
}
