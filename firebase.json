{
  "hosting": {
    "public": "hosting-redirect",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "redirects": [
      {
        "regex": "^/(?P<rest>(?:[^_].*|_[^_].*)?)$",
        "destination": "https://bohtreinar.marcelo-labs.workers.dev/:rest",
        "type": 301
      }
    ]
  },
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  }
}
