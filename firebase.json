{
  "hosting": {
    "public": "hosting-redirect",
    "ignore": ["firebase.json", "**/.*", "**/node_modules/**"],
    "redirects": [
      {
        "source": "/:path*",
        "destination": "https://bohtreinar.marcelo-labs.workers.dev/:path*",
        "type": 301
      }
    ]
  },
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  }
}
