{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "bohtreinar-academy-worker-hml",
  "main": "src/index.js",
  "compatibility_date": "2026-10-01",
  "workers_dev": true,
  "preview_urls": false,
  // Homologação. Produção terá config própria (nome, projeto Firebase, origens e secrets diferentes).
  "ratelimits": [
    { "name": "GESTAO_IP_LIMIT", "namespace_id": "42001", "simple": { "limit": 60, "period": 60 } },
    { "name": "GESTAO_USER_LIMIT", "namespace_id": "42002", "simple": { "limit": 60, "period": 60 } },
    { "name": "GESTAO_ACADEMY_LIMIT", "namespace_id": "42003", "simple": { "limit": 300, "period": 60 } }
  ],
  "d1_databases": [
    { "binding": "DB", "database_name": "bohtreinar-gestao-hml", "database_id": "2cd73cfb-7b19-4725-9a68-4b82d0e09115", "migrations_dir": "migrations" }
  ],
  "vars": {
    "FIREBASE_PROJECT_ID": "bohtreinar-gestao-hml",
    "ALLOWED_ORIGINS": "http://localhost:5174",
    // Kill switch: com "false" todo endpoint que escreve responde 503 sem tocar no banco. Nenhum endpoint escreve ainda.
    "ADMIN_OPS_ENABLED": "true"
  }
}
