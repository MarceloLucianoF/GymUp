{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "bohtreinar-academy-worker-hml",
  "main": "src/index.js",
  "compatibility_date": "2026-10-01",
  "workers_dev": true,
  "preview_urls": false,
  // Homologação. Produção terá config própria (nome, projeto Firebase, origens e secrets diferentes).
  "ratelimits": [
    { "name": "GESTAO_IP_LIMIT", "namespace_id": "42001", "simple": { "limit": 300, "period": 60 } },
    { "name": "GESTAO_USER_LIMIT", "namespace_id": "42002", "simple": { "limit": 120, "period": 60 } },
    { "name": "GESTAO_ACADEMY_LIMIT", "namespace_id": "42003", "simple": { "limit": 120, "period": 60 } }
  ],
  "d1_databases": [
    { "binding": "DB", "database_name": "bohtreinar-gestao-hml", "database_id": "c15f6ec4-c212-4ae0-8fc5-3fe53453ca57", "migrations_dir": "migrations" }
  ],
  "vars": {
    "FIREBASE_PROJECT_ID": "bohtreinar-gestao-hml",
    "ALLOWED_ORIGINS": "http://localhost:5174,https://bohtreinar-gestao-hml.marcelo-labs.workers.dev",
    // Kill switch: com "false" todo endpoint que escreve responde 503 sem tocar no banco. Nenhum endpoint escreve ainda.
    "ADMIN_OPS_ENABLED": "true"
  }
}
