rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function hasRole(role) {
      return signedIn()
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == role;
    }

    function isAdmin() {
      return hasRole('admin');
    }

    function isCoach() {
      return hasRole('coach');
    }

    function isTrainerId(uid) {
      return uid is string && uid.size() > 0
        && get(/databases/$(database)/documents/users/$(uid)).data.role in ['coach', 'admin'];
    }

    function linkedStudent(data) {
      return isCoach() && data.role == 'user'
        && data.get('coachId', null) == request.auth.uid;
    }

    function canAccessUserData(uid) {
      return signedIn() && uid is string && (
        request.auth.uid == uid || isAdmin()
        || linkedStudent(get(/databases/$(database)/documents/users/$(uid)).data)
      );
    }

    // coachId is consent granted by the student, never a coach's self-assignment.
    function validCoachLink(data, uid) {
      let coachId = data.get('coachId', null);
      return coachId == null || (
        data.role == 'user' && coachId != uid && isTrainerId(coachId)
      );
    }

    function validUser(data, uid) {
      return data.role in ['user', 'coach', 'admin']
        && data.get('uid', uid) == uid
        && validCoachLink(data, uid);
    }

    // Campos do onboarding: valores restritos a conjuntos conhecidos.
    function validProfileExtras(data) {
      return data.get('experience', 'iniciante') in ['iniciante', 'intermediario', 'avancado']
        && data.get('weeklyGoal', 4) is int
        && data.get('weeklyGoal', 4) >= 2 && data.get('weeklyGoal', 4) <= 7
        && data.get('onboardedAt', '') is string
        && data.get('gymEquipment', []) is list && data.get('gymEquipment', []).size() <= 6
        && data.get('gymEquipment', []).hasOnly(['maquina', 'polia', 'halter', 'barra', 'livre', 'cardio'])
        && validPhone(data);
    }

    // Aceite dos termos (LGPD): data ISO e versão do texto, gravados só na criação da conta.
    function validTerms(data) {
      return data.get('termsAcceptedAt', '') is string
        && data.get('termsVersion', '') is string
        && data.get('termsVersion', '').size() <= 20;
    }

    // Telefone do aluno: só dígitos e símbolos comuns; visível ao treinador vinculado (que lê o perfil).
    function validPhone(data) {
      return data.get('phone', '') is string
        && data.get('phone', '').matches('^[0-9+() -]{0,20}$');
    }

    // Troca de e-mail: o perfil só pode copiar o e-mail já confirmado do login (nunca um e-mail qualquer).
    function emailCopyOk(fields) {
      return !fields.hasAny(['email'])
        || (request.auth.token.get('email_verified', false) == true && request.resource.data.email == request.auth.token.get('email', ''));
    }

    function ownProfileChanges() {
      let fields = request.resource.data.diff(resource.data).affectedKeys();
      // coachId: o aluno só pode DESFAZER o vínculo (null). Vincular passa por coachLinks e o aceite do treinador.
      return (fields.hasOnly([
        'displayName', 'goal', 'height', 'weight', 'age', 'photoURL',
        'updatedAt', 'lastWorkoutDate', 'coachId',
        'experience', 'weeklyGoal', 'onboardedAt', 'phone', 'gymEquipment', 'email'
      ]) && validProfileExtras(request.resource.data)
        && emailCopyOk(fields)
        && (!fields.hasAny(['coachId']) || request.resource.data.get('coachId', null) == null)) || (isCoach() && fields.hasOnly([
        'displayName', 'goal', 'height', 'weight', 'age', 'photoURL',
        'updatedAt', 'lastWorkoutDate', 'bio', 'phone', 'pixKey', 'defaultMonthlyFee', 'email'
      ]) && emailCopyOk(fields));
    }

    function validCoachAssignment() {
      let nextId = request.resource.data.get('currentTrainingId', null);
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny(['currentTrainingId'])
        || nextId == null
        || (nextId is string
          && ownsCoachTraining(get(/databases/$(database)/documents/trainings/$(nextId)).data));
    }

    // Mensalidade: número entre 0 (isento) e 100000 (o valor final fica registrado no aluno).
    function validFee() {
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny(['monthlyFee'])
        || (request.resource.data.monthlyFee is number && request.resource.data.monthlyFee >= 0 && request.resource.data.monthlyFee <= 100000);
    }
    // Situação de cobrança: pending | paid | overdue | exempt. "Isento" e mensalidade 0 andam juntos (um implica o outro) sempre
    // que um dos dois campos muda; aluno antigo sem mudança de cobrança não é afetado.
    function feeStatusOk() {
      let d = request.resource.data;
      return !d.diff(resource.data).affectedKeys().hasAny(['monthlyFee', 'paymentStatus'])
        || (d.get('paymentStatus', 'pending') in ['pending', 'paid', 'overdue', 'exempt']
          && ((d.get('paymentStatus', 'pending') == 'exempt') == (d.get('monthlyFee', 1) == 0)));
    }

    // No aceite de um aluno novo a mensalidade, quando enviada, tem de ser maior que zero.
    function positiveFeeOnAccept() {
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny(['monthlyFee']) || request.resource.data.monthlyFee > 0;
    }

    // Vínculo aluno-treinador: o treinador aceita (coachLinks pending -> active) e, no mesmo lote, grava coachId no aluno.
    function coachAcceptsLink(studentId) {
      let link = get(/databases/$(database)/documents/coachLinks/$(studentId)).data;
      return isCoach()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['coachId', 'updatedAt', 'monthlyFee', 'paymentStatus'])
        && validFee() && positiveFeeOnAccept()
        && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['paymentStatus'])
          || request.resource.data.paymentStatus == 'pending')
        && resource.data.role == 'user' && resource.data.get('coachId', null) == null
        && request.resource.data.coachId == request.auth.uid
        && link.coachId == request.auth.uid && link.status == 'pending'
        && getAfter(/databases/$(database)/documents/coachLinks/$(studentId)).data.status == 'active';
    }

    // O treinador pode encerrar o vínculo dos próprios alunos (coachId vira null).
    function coachEndsLink() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(['coachId', 'updatedAt'])
        && request.resource.data.get('coachId', null) == null;
    }

    match /users/{userId} {
      allow get, list: if signedIn() && (
        request.auth.uid == userId || isAdmin() || linkedStudent(resource.data)
      );
      allow create: if signedIn() && validUser(request.resource.data, userId) && (
        isAdmin() || (
          request.auth.uid == userId
          && request.resource.data.uid == userId
          && request.resource.data.role == 'user'
          && request.resource.data.get('currentTrainingId', null) == null
          && validTerms(request.resource.data)
          && request.resource.data.keys().hasOnly([
            'uid', 'displayName', 'email', 'role', 'createdAt', 'age',
            'weight', 'height', 'photoURL', 'coachId', 'currentTrainingId',
            'termsAcceptedAt', 'termsVersion'
          ])
        )
      );
      allow update: if signedIn() && validUser(request.resource.data, userId)
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['uid'])
        && (
          isAdmin() || (
            request.resource.data.role == resource.data.role
            && (
              (request.auth.uid == userId && ownProfileChanges())
              || (linkedStudent(resource.data) && validCoachAssignment() && validFee() && feeStatusOk()
                && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
                  'currentTrainingId', 'monthlyFee', 'paymentStatus',
                  'paymentDate', 'lastPaymentUpdate', 'updatedAt'
                ]))
              || coachAcceptsLink(userId)
              || (linkedStudent(resource.data) && coachEndsLink())
            )
          )
        );
      // Admin ou o próprio ALUNO (exclusão de conta). Treinador/admin só são removidos por um admin.
      allow delete: if isAdmin() || (request.auth.uid == userId && resource.data.role == 'user');
    }

    function validUserOwnedData(data) {
      return data.userId is string && data.userId.size() > 0;
    }

    function validPublicCoachProfile(data, coachId) {
      return data.keys().hasOnly(['uid', 'displayName', 'photoURL', 'bio', 'role', 'updatedAt'])
        && data.uid == coachId && data.role in ['coach', 'admin']
        && data.displayName is string
        && data.get('photoURL', '') is string
        && data.get('bio', '') is string
        && (data.get('updatedAt', '') is string || data.updatedAt is timestamp);
    }

    match /publicCoachProfiles/{coachId} {
      // Public reads are safe only while the document contains this exact public schema.
      allow get, list: if validPublicCoachProfile(resource.data, coachId);
      allow create, update: if validPublicCoachProfile(request.resource.data, coachId)
        && request.resource.data.role == get(/databases/$(database)/documents/users/$(coachId)).data.role
        && (isAdmin() || (request.auth.uid == coachId && isCoach()));
      allow delete: if isAdmin();
    }

    // Leitura: dono, admin ou treinador vinculado. Escrita: somente o dono (ou admin),
    // para que o treinador não forje nem apague dados do aluno.
    function ownerOrAdmin(uid) {
      return signedIn() && uid is string && (request.auth.uid == uid || isAdmin());
    }

    // Solicitações de vínculo (1 por aluno: o ID é o do aluno). Só participantes leem; o aluno pede/cancela,
    // o treinador aceita (junto de users.coachId, no mesmo lote), recusa ou encerra.
    function coachLinkShape(d) {
      return d.keys().hasOnly(['studentId', 'studentName', 'coachId', 'status', 'requestedBy', 'createdAt', 'updatedAt', 'inviteId'])
        && d.studentId is string && d.coachId is string
        && d.get('inviteId', 'i_x') is string && d.get('inviteId', 'i_x').size() <= 40
        && d.status in ['pending', 'active', 'rejected', 'revoked']
        && d.createdAt is string && d.updatedAt is string
        && d.get('studentName', '') is string && d.get('studentName', '').size() <= 100;
    }

    // Convite por link (coachInvites): validade, limite de usos e revogação. Pedido com inviteId só passa se o convite está
    // válido e o mesmo lote soma exatamente 1 uso (conferido por getAfter); sem inviteId vale o código fixo do treinador.
    function invitePath(id) {
      return /databases/$(database)/documents/coachInvites/$(id);
    }
    function inviteAllows(link) {
      return !('inviteId' in link) || (
        exists(invitePath(link.inviteId))
        && get(invitePath(link.inviteId)).data.coachId == link.coachId
        && get(invitePath(link.inviteId)).data.revoked == false
        && get(invitePath(link.inviteId)).data.expiresAt > request.time
        && get(invitePath(link.inviteId)).data.uses < get(invitePath(link.inviteId)).data.maxUses
        && getAfter(invitePath(link.inviteId)).data.uses == get(invitePath(link.inviteId)).data.uses + 1
      );
    }

    match /coachInvites/{inviteId} {
      // O ID é um segredo não adivinhável (só vale com o link); o documento não tem dado pessoal.
      allow get: if true;
      allow list: if signedIn() && (isAdmin() || resource.data.coachId == request.auth.uid);
      // Admin também atua como treinador (isTrainerId aceita os dois papéis): precisa poder criar convites.
      allow create: if signedIn() && (isCoach() || isAdmin()) && inviteId.matches('^i_[A-Za-z0-9]{20}$')
        && request.resource.data.keys().hasOnly(['coachId', 'createdAt', 'expiresAt', 'maxUses', 'uses', 'revoked'])
        && request.resource.data.coachId == request.auth.uid
        && request.resource.data.createdAt is string
        && request.resource.data.uses == 0 && request.resource.data.revoked == false
        && request.resource.data.maxUses is int && request.resource.data.maxUses >= 1 && request.resource.data.maxUses <= 200
        && request.resource.data.expiresAt is timestamp
        && request.resource.data.expiresAt >= request.time + duration.value(1, 'h')
        && request.resource.data.expiresAt <= request.time + duration.value(31, 'd');
      allow update: if signedIn() && (
        // treinador: só revoga
        (resource.data.coachId == request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['revoked'])
          && request.resource.data.revoked == true)
        // aluno: consome 1 uso junto do próprio pedido de vínculo (mesmo lote), com o convite ainda válido
        || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['uses'])
          && request.resource.data.uses == resource.data.uses + 1
          && request.resource.data.uses <= resource.data.maxUses
          && resource.data.revoked == false && resource.data.expiresAt > request.time
          && getAfter(/databases/$(database)/documents/coachLinks/$(request.auth.uid)).data.get('inviteId', null) == inviteId
          && getAfter(/databases/$(database)/documents/coachLinks/$(request.auth.uid)).data.status == 'pending'
          && getAfter(/databases/$(database)/documents/coachLinks/$(request.auth.uid)).data.coachId == resource.data.coachId
          // o pedido tem de ser ESCRITO neste lote (criado ou com updatedAt novo): sem isso, um pedido antigo serviria de álibi
          // para gastar usos em loop
          && (!exists(/databases/$(database)/documents/coachLinks/$(request.auth.uid))
            || getAfter(/databases/$(database)/documents/coachLinks/$(request.auth.uid)).data.updatedAt
               != get(/databases/$(database)/documents/coachLinks/$(request.auth.uid)).data.updatedAt))
      );
      allow delete: if signedIn() && (isAdmin() || resource.data.coachId == request.auth.uid);
    }

    match /coachLinks/{studentId} {
      allow get: if signedIn() && (request.auth.uid == studentId || isAdmin() || (resource != null && resource.data.coachId == request.auth.uid));
      allow list: if signedIn() && (resource.data.coachId == request.auth.uid || resource.data.studentId == request.auth.uid || isAdmin());
      allow create: if signedIn() && request.auth.uid == studentId && coachLinkShape(request.resource.data)
        && request.resource.data.studentId == studentId && request.resource.data.status == 'pending'
        && request.resource.data.requestedBy == 'student'
        && request.resource.data.coachId != studentId && isTrainerId(request.resource.data.coachId)
        && get(/databases/$(database)/documents/users/$(studentId)).data.get('coachId', null) == null
        && inviteAllows(request.resource.data);
      allow update: if signedIn() && coachLinkShape(request.resource.data) && request.resource.data.studentId == studentId && (
        // aluno: pedir de novo (sem treinador ativo) ou cancelar/encerrar
        (request.auth.uid == studentId && (
          (request.resource.data.status == 'pending' && request.resource.data.requestedBy == 'student'
            && request.resource.data.coachId != studentId && isTrainerId(request.resource.data.coachId)
            && get(/databases/$(database)/documents/users/$(studentId)).data.get('coachId', null) == null
            && inviteAllows(request.resource.data)
            && (!('inviteId' in request.resource.data) || resource.data.get('inviteId', null) != request.resource.data.inviteId))
          || (request.resource.data.status == 'revoked' && request.resource.data.coachId == resource.data.coachId
            && request.resource.data.get('inviteId', null) == resource.data.get('inviteId', null)
            && request.resource.data.createdAt == resource.data.createdAt
            && request.resource.data.requestedBy == resource.data.requestedBy)))
        // treinador: aceitar, recusar ou encerrar; nada além do status muda
        || (resource.data.coachId == request.auth.uid && request.resource.data.coachId == resource.data.coachId
          && request.resource.data.requestedBy == resource.data.requestedBy
          && request.resource.data.createdAt == resource.data.createdAt
          && request.resource.data.get('inviteId', null) == resource.data.get('inviteId', null)
          && request.resource.data.get('studentName', '') == resource.data.get('studentName', '')
          && request.resource.data.status in ['active', 'rejected', 'revoked']
          && (request.resource.data.status != 'active' || (resource.data.status == 'pending'
            && getAfter(/databases/$(database)/documents/users/$(studentId)).data.get('coachId', null) == request.auth.uid)))
      );
      allow delete: if isAdmin();
    }

    match /measurements/{docId} {
      allow get, list: if canAccessUserData(resource.data.userId);
      allow create: if validUserOwnedData(request.resource.data)
        && ownerOrAdmin(request.resource.data.userId);
      allow update: if validUserOwnedData(request.resource.data)
        && request.resource.data.userId == resource.data.userId
        && ownerOrAdmin(resource.data.userId);
      allow delete: if ownerOrAdmin(resource.data.userId);
    }

    // ---- Saúde (itens 15/19): avaliação física, anamnese e consentimento (LGPD art. 11, dado sensível) ----
    // Quem lê: o próprio aluno e o professor VINCULADO (mesmo critério de linkedStudent) com consentimento em
    // healthConsents/{uid} em nome dele. Admin NÃO lê. Apagar o consentimento corta o acesso na hora.
    function healthConsentPath(uid) {
      return /databases/$(database)/documents/healthConsents/$(uid);
    }

    function healthOwner(uid) {
      return signedIn() && uid is string && request.auth.uid == uid;
    }

    function healthCoach(uid) {
      return signedIn() && uid is string && uid != request.auth.uid
        && linkedStudent(get(/databases/$(database)/documents/users/$(uid)).data)
        && exists(healthConsentPath(uid))
        && get(healthConsentPath(uid)).data.coachId == request.auth.uid;
    }

    function hNum(m, k, lo, hi) {
      return !(k in m) || (m[k] is number && m[k] >= lo && m[k] <= hi);
    }

    function hText(m, k, max) {
      return !(k in m) || (m[k] is string && m[k].size() <= max);
    }

    function hIso(v) {
      return v is string && v.size() <= 40 && v.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}([T ].*)?$');
    }

    function validPerimeters(m) {
      return m is map && m.keys().hasOnly(['arm', 'chest', 'waist', 'hip', 'thigh', 'calf'])
        && hNum(m, 'arm', 5, 250) && hNum(m, 'chest', 5, 250) && hNum(m, 'waist', 5, 250)
        && hNum(m, 'hip', 5, 250) && hNum(m, 'thigh', 5, 250) && hNum(m, 'calf', 5, 250);
    }

    // Dobras cutâneas em mm. pollock3: peito/abdome/coxa (homem) ou tríceps/suprailíaca/coxa (mulher); pollock7: as 7.
    function validSkinfolds(m) {
      return m is map
        && m.keys().hasOnly(['protocol', 'chest', 'abdomen', 'thigh', 'triceps', 'suprailiac', 'subscapular', 'midaxillary'])
        && m.get('protocol', '') in ['pollock3', 'pollock7']
        && hNum(m, 'chest', 1, 90) && hNum(m, 'abdomen', 1, 90) && hNum(m, 'thigh', 1, 90) && hNum(m, 'triceps', 1, 90)
        && hNum(m, 'suprailiac', 1, 90) && hNum(m, 'subscapular', 1, 90) && hNum(m, 'midaxillary', 1, 90);
    }

    function validBioimpedance(m) {
      return m is map && m.keys().hasOnly(['bodyFat', 'leanMass', 'water', 'visceralFat'])
        && hNum(m, 'bodyFat', 1, 80) && hNum(m, 'leanMass', 5, 200) && hNum(m, 'water', 10, 90) && hNum(m, 'visceralFat', 0, 60);
    }

    function validAssessment(d) {
      return d.keys().hasOnly(['userId', 'coachId', 'kind', 'date', 'createdAt', 'updatedAt', 'createdBy', 'sex', 'age',
          'weight', 'height', 'perimeters', 'skinfolds', 'bodyFat', 'bioimpedance', 'notes'])
        && d.keys().hasAll(['userId', 'kind', 'date', 'createdAt', 'createdBy'])
        && d.userId is string && d.userId.size() > 0 && d.userId.size() <= 128
        && d.createdBy is string && d.createdBy.size() <= 128
        && (!('coachId' in d) || (d.coachId is string && d.coachId.size() <= 128))
        && d.kind in ['instructor', 'bioimpedance', 'self']
        && hIso(d.date) && hIso(d.createdAt) && (!('updatedAt' in d) || hIso(d.updatedAt))
        && (!('sex' in d) || d.sex in ['male', 'female'])
        && (!('age' in d) || (d.age is int && d.age >= 10 && d.age <= 100))
        && hNum(d, 'weight', 20, 400) && hNum(d, 'height', 80, 250) && hNum(d, 'bodyFat', 2, 70)
        && (!('perimeters' in d) || validPerimeters(d.perimeters))
        && (!('skinfolds' in d) || validSkinfolds(d.skinfolds))
        && (!('bioimpedance' in d) || validBioimpedance(d.bioimpedance))
        && hText(d, 'notes', 500);
    }

    // Avaliação do instrutor: só o professor que a lançou, enquanto vinculado e com consentimento.
    function instructorAssessmentBy(d) {
      return d.kind == 'instructor' && d.get('coachId', null) == request.auth.uid && healthCoach(d.userId);
    }

    match /assessments/{assessmentId} {
      allow get, list: if healthOwner(resource.data.userId) || healthCoach(resource.data.userId);
      allow create: if validAssessment(request.resource.data)
        && request.resource.data.createdBy == request.auth.uid
        && ((healthOwner(request.resource.data.userId) && request.resource.data.kind in ['self', 'bioimpedance']
            && !('coachId' in request.resource.data))
          || instructorAssessmentBy(request.resource.data));
      allow update: if validAssessment(request.resource.data)
        && request.resource.data.diff(resource.data).unchangedKeys().hasAll(['userId', 'kind', 'createdBy', 'createdAt'])
        && request.resource.data.get('coachId', null) == resource.data.get('coachId', null)
        && resource.data.createdBy == request.auth.uid
        && ((healthOwner(resource.data.userId) && resource.data.kind in ['self', 'bioimpedance'])
          || instructorAssessmentBy(resource.data));
      // O aluno apaga qualquer avaliação dele (inclusive a do instrutor); o professor, só as que lançou.
      allow delete: if healthOwner(resource.data.userId) || instructorAssessmentBy(resource.data);
    }

    function validParq(l) {
      return l is list && l.size() == 7
        && l[0] is bool && l[1] is bool && l[2] is bool && l[3] is bool && l[4] is bool && l[5] is bool && l[6] is bool;
    }

    function validAnamnesis(d) {
      return d.keys().hasOnly(['userId', 'version', 'createdAt', 'parq', 'injuries', 'surgeries', 'medications',
          'diseases', 'goals', 'routine', 'notes'])
        && d.keys().hasAll(['userId', 'version', 'createdAt', 'parq'])
        && d.userId is string && d.userId.size() > 0 && d.userId.size() <= 128
        && d.version is int && d.version >= 1 && d.version <= 1000
        && hIso(d.createdAt) && validParq(d.parq)
        && hText(d, 'injuries', 1000) && hText(d, 'surgeries', 1000) && hText(d, 'medications', 1000)
        && hText(d, 'diseases', 1000) && hText(d, 'goals', 1000) && hText(d, 'routine', 1000) && hText(d, 'notes', 1000);
    }

    // Anamnese: só o aluno escreve; cada envio é uma versão nova (sem edição). O professor com consentimento lê.
    match /anamneses/{anamnesisId} {
      allow get, list: if healthOwner(resource.data.userId) || healthCoach(resource.data.userId);
      allow create: if validAnamnesis(request.resource.data) && healthOwner(request.resource.data.userId);
      allow update: if false;
      allow delete: if healthOwner(resource.data.userId);
    }

    // Consentimento (1 por aluno), só para o professor vinculado atual; o aluno revoga apagando. O professor nomeado pode
    // apagar (encerrar o vínculo também encerra o consentimento), nunca criar nem alterar.
    match /healthConsents/{uid} {
      allow get: if healthOwner(uid) || (signedIn()
        && linkedStudent(get(/databases/$(database)/documents/users/$(uid)).data)
        && (resource == null || resource.data.coachId == request.auth.uid));
      allow list: if false;
      allow create, update: if healthOwner(uid)
        && request.resource.data.keys().hasOnly(['coachId', 'version', 'acceptedAt'])
        && request.resource.data.keys().hasAll(['coachId', 'version', 'acceptedAt'])
        && request.resource.data.coachId is string
        && request.resource.data.coachId == get(/databases/$(database)/documents/users/$(uid)).data.get('coachId', null)
        && request.resource.data.version is string && request.resource.data.version.size() >= 1
        && request.resource.data.version.size() <= 20
        && hIso(request.resource.data.acceptedAt);
      allow delete: if healthOwner(uid) || (signedIn() && resource != null && resource.data.coachId == request.auth.uid);
    }

    // Contador de check-ins por aluno (sem dados de saúde). O cliente só o altera junto da criação ou remoção de um
    // check-in no mesmo lote/transação: as regras conferem o estado "depois" (existsAfter/getAfter), então não dá para
    // inflar ou zerar o número sozinho. O admin lê a lista e pode reconciliar.
    function ciPath(id) {
      return /databases/$(database)/documents/checkIns/$(id);
    }

    function statsShape(d) {
      return d.keys().hasOnly(['uid', 'checkInCount', 'lastCheckInAt', 'lastCheckInId', 'lastRemovedId',
          'weekKey', 'weekCount', 'weekDays', 'streak', 'lastActiveDay'])
        && d.uid == request.auth.uid
        && d.checkInCount is int && d.checkInCount >= 0
        && d.lastCheckInAt is string && d.lastCheckInId is string
        && d.get('weekCount', 0) is int && d.get('weekCount', 0) >= 0 && d.get('weekCount', 0) <= d.checkInCount
        && d.get('streak', 0) is int && d.get('streak', 0) >= 0 && d.get('streak', 0) <= 3660
        && d.get('weekKey', '') is string && (d.get('weekKey', '') == '' || d.get('weekKey', '').matches('^[0-9]{4}-W[0-9]{2}$'))
        && d.get('lastActiveDay', '') is string && (d.get('lastActiveDay', '') == '' || d.get('lastActiveDay', '').matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$'))
        && d.get('weekDays', []) is list && d.get('weekDays', []).size() <= 7;
    }

    // Consistência semanal: cada check-in novo soma no máximo 1 (ou reinicia a semana em 1); a sequência cresce no máximo 1.
    function weeklyOkOnCreate(d) {
      return d.get('weekCount', 1) <= 1 && d.get('streak', 1) <= 1;
    }
    // Semana e último dia ativo nunca andam para trás; a sequência só sobe (+1) quando o último dia ativo avança.
    // Assim apagar e recriar o mesmo check-in não infla a sequência.
    function weeklyOkOnIncrement(d, old) {
      return d.get('weekCount', 1) <= old.get('weekCount', 0) + 1
        && d.get('weekKey', '') >= old.get('weekKey', '')
        && d.get('lastActiveDay', '') >= old.get('lastActiveDay', '')
        && d.get('streak', 1) <= old.get('streak', 0) + 1
        && (d.get('streak', 0) <= old.get('streak', 0) || d.get('lastActiveDay', '') > old.get('lastActiveDay', ''));
    }
    // Apagar um check-in só pode baixar números: semana, último dia e sequência ficam como estavam e os dias ativos só encolhem.
    function weeklyOkOnDecrement(d, old) {
      return d.get('weekCount', 0) <= old.get('weekCount', 0) && d.get('weekCount', 0) >= old.get('weekCount', 0) - 1
        && d.get('streak', 0) == old.get('streak', 0)
        && d.get('weekKey', '') == old.get('weekKey', '')
        && d.get('lastActiveDay', '') == old.get('lastActiveDay', '')
        && old.get('weekDays', []).hasAll(d.get('weekDays', []));
    }

    // Amigos que participam do ranking leem os contadores um do outro (nenhum dado de saúde está em userStats).
    function pairId(a, b) {
      return a < b ? a + '_' + b : b + '_' + a;
    }
    function friendPath(a, b) {
      return /databases/$(database)/documents/friendships/$(pairId(a, b));
    }
    function statsPath(uid) {
      return /databases/$(database)/documents/userStats/$(uid);
    }
    function profilePath(uid) {
      return /databases/$(database)/documents/publicProfiles/$(uid);
    }
    function sharesRanking(uid) {
      return exists(profilePath(uid)) && get(profilePath(uid)).data.get('shareRanking', false) == true;
    }
    function rankingFriends(other) {
      return exists(friendPath(request.auth.uid, other)) && get(friendPath(request.auth.uid, other)).data.status == 'active'
        && sharesRanking(other) && sharesRanking(request.auth.uid);
    }

    function createdNow(id) {
      return id is string && id.size() > 0
        && !exists(ciPath(id)) && existsAfter(ciPath(id))
        && getAfter(ciPath(id)).data.userId == request.auth.uid;
    }

    function removedNow(id) {
      return id is string && id.size() > 0
        && exists(ciPath(id)) && !existsAfter(ciPath(id))
        && get(ciPath(id)).data.userId == request.auth.uid;
    }

    match /userStats/{statsId} {
      allow get: if signedIn() && (request.auth.uid == statsId || isAdmin());
      allow list: if isAdmin();
      allow create: if signedIn() && request.auth.uid == statsId && statsShape(request.resource.data)
        && request.resource.data.checkInCount == 1 && weeklyOkOnCreate(request.resource.data)
        && !('lastRemovedId' in request.resource.data)
        && createdNow(request.resource.data.lastCheckInId);
      allow update: if (signedIn() && request.auth.uid == statsId && statsShape(request.resource.data) && (
          (request.resource.data.checkInCount == resource.data.checkInCount + 1
            && !('lastRemovedId' in request.resource.data)
            && request.resource.data.lastCheckInId != resource.data.lastCheckInId
            && weeklyOkOnIncrement(request.resource.data, resource.data)
            && createdNow(request.resource.data.lastCheckInId))
          || (request.resource.data.checkInCount == resource.data.checkInCount - 1
            && request.resource.data.lastCheckInId == resource.data.lastCheckInId
            && weeklyOkOnDecrement(request.resource.data, resource.data)
            && removedNow(request.resource.data.get('lastRemovedId', null)))
        )) || isAdmin();
      allow create: if isAdmin();
      allow delete: if (signedIn() && request.auth.uid == statsId) || isAdmin();
    }

    // Cópia pública mínima para o ranking: só o que o ranking mostra, sempre igual ao userStats do mesmo dono (nenhum horário, nenhum total).
    match /publicStats/{statsId} {
      allow get: if signedIn() && (request.auth.uid == statsId || isAdmin() || rankingFriends(statsId));
      allow list: if false;
      allow create, update: if signedIn() && request.auth.uid == statsId
        && request.resource.data.keys().hasOnly(['uid', 'weekKey', 'weekWorkouts', 'activeDays', 'streak', 'lastActiveDay', 'updatedAt'])
        && request.resource.data.uid == statsId && request.resource.data.updatedAt is string
        && existsAfter(statsPath(statsId))
        && request.resource.data.weekKey == getAfter(statsPath(statsId)).data.get('weekKey', '')
        && request.resource.data.weekWorkouts == getAfter(statsPath(statsId)).data.get('weekCount', 0)
        && request.resource.data.activeDays == getAfter(statsPath(statsId)).data.get('weekDays', []).size()
        && request.resource.data.streak == getAfter(statsPath(statsId)).data.get('streak', 0)
        && request.resource.data.lastActiveDay == getAfter(statsPath(statsId)).data.get('lastActiveDay', '');
      allow delete: if (signedIn() && request.auth.uid == statsId) || isAdmin();
    }

    match /checkIns/{docId} {
      // Sem listagem ampla (nem para admin): métricas vêm de userStats. Ler um ID inexistente é permitido
      // (a gravação idempotente precisa saber se o check-in já existe).
      allow get: if signedIn() && (resource == null || canAccessUserData(resource.data.userId));
      allow list: if canAccessUserData(resource.data.userId);
      allow create: if validUserOwnedData(request.resource.data)
        && ownerOrAdmin(request.resource.data.userId);
      allow update: if validUserOwnedData(request.resource.data)
        && request.resource.data.userId == resource.data.userId
        && ownerOrAdmin(resource.data.userId);
      allow delete: if ownerOrAdmin(resource.data.userId);
    }

    function isParticipant(data) {
      return signedIn() && request.auth.uid in data.participants;
    }

    function isStudentCoachPair(studentId, coachId) {
      let student = get(/databases/$(database)/documents/users/$(studentId)).data;
      return student.role == 'user' && student.get('coachId', null) == coachId
        && isTrainerId(coachId);
    }

    function validChatParticipants(data) {
      return data.participants is list && data.participants.size() == 2
        && data.participants[0] is string && data.participants[1] is string
        && data.participants[0].size() > 0 && data.participants[1].size() > 0
        && data.participants[0] != data.participants[1]
        && isParticipant(data)
        && (isStudentCoachPair(data.participants[0], data.participants[1])
          || isStudentCoachPair(data.participants[1], data.participants[0]));
    }

    function chatParticipant(chatId) {
      return isParticipant(get(/databases/$(database)/documents/chats/$(chatId)).data);
    }

    // Depois que o vínculo termina, o treinador deixa de ler e de escrever na conversa (o aluno continua dono dela).
    // A lista de conversas (list) não consegue conferir o vínculo por documento, então ainda mostra a linha da conversa;
    // as mensagens, que são o conteúdo, ficam protegidas aqui.
    function chatPairLinked(chatId) {
      let p = get(/databases/$(database)/documents/chats/$(chatId)).data.participants;
      return isStudentCoachPair(p[0], p[1]) || isStudentCoachPair(p[1], p[0]);
    }
    // Ler: o aluno sempre (histórico e exclusão de conta); o treinador só enquanto vinculado.
    function chatAccess(chatId) {
      return chatParticipant(chatId) && (hasRole('user') || chatPairLinked(chatId));
    }
    // Escrever: só com o vínculo ativo, para os dois lados (depois do desvínculo a conversa fica só para leitura do aluno).
    function chatWrite(chatId) {
      return chatParticipant(chatId) && chatPairLinked(chatId);
    }

    match /chats/{chatId} {
      // A guessed ID never authorizes reading someone else's chat. Um chat que ainda não existe só pode ser consultado por
      // quem faz parte do ID (menor_maior): sem isso ninguém consegue abrir a primeira conversa de um par (o get de um
      // documento inexistente era negado e o app mostrava "Erro ao conectar").
      allow get: if signedIn() && (resource == null
        ? (chatId.matches(request.auth.uid + '_.*') || chatId.matches('.*_' + request.auth.uid))
        : isParticipant(resource.data));
      allow list: if isParticipant(resource.data);
      allow create: if validChatParticipants(request.resource.data)
        && (chatId == request.resource.data.participants[0] + '_' + request.resource.data.participants[1]
          || chatId == request.resource.data.participants[1] + '_' + request.resource.data.participants[0])
        && request.resource.data.keys().hasOnly([
          'participants', 'participantData', 'createdAt', 'updatedAt', 'lastMessage'
        ])
        && request.resource.data.participantData is map
        && request.resource.data.participantData.keys().hasOnly(request.resource.data.participants)
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time
        && request.resource.data.lastMessage == '';
      allow update: if chatWrite(chatId)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['lastMessage', 'updatedAt'])
        && request.resource.data.lastMessage is string
        && request.resource.data.lastMessage.size() <= 10000
        && request.resource.data.updatedAt == request.time;
      // Exclusão de conta (LGPD): só o ALUNO participante apaga a conversa, depois de apagar as mensagens.
      // O treinador não apaga conversas pelo cliente.
      allow delete: if isParticipant(resource.data) && hasRole('user');

      match /messages/{msgId} {
        allow get, list: if chatAccess(chatId);
        allow create: if chatWrite(chatId)
          && request.resource.data.keys().hasOnly(['text', 'senderId', 'createdAt', 'senderName'])
          && request.resource.data.senderId == request.auth.uid
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0
          && request.resource.data.text.size() <= 10000
          && request.resource.data.get('senderName', '') is string
          && request.resource.data.createdAt == request.time;
        allow update: if chatWrite(chatId)
          && resource.data.senderId == request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['text'])
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0
          && request.resource.data.text.size() <= 10000;
        // O remetente apaga as próprias mensagens; o aluno da conversa pode apagar todas (exclusão de conta).
        allow delete: if chatParticipant(chatId)
          && (resource.data.senderId == request.auth.uid || hasRole('user'));
      }
    }

    function validTraining(data) {
      return data.name is string && data.name.size() > 0 && data.exercises is list
        && (data.get('coachId', null) == null || data.coachId is string)
        && (data.get('createdBy', null) == null || data.createdBy is string)
        && data.get('isAIGenerated', false) is bool;
    }

    // coachId is authoritative; createdBy is the fallback for older creator-owned fichas.
    function ownsCoachTraining(data) {
      return isCoach() && (
        data.get('coachId', null) == request.auth.uid
        || (data.get('coachId', null) == null && data.get('createdBy', null) == request.auth.uid)
      );
    }

    function ownsAITraining(data) {
      return signedIn() && data.get('createdBy', null) == request.auth.uid
        && data.get('isAIGenerated', false) == true && data.get('coachId', null) == null;
    }

    // Treinos pessoais do aluno (digitados ou importados de PDF): privados, fora da loja de fichas. Só o dono lê e grava.
    match /users/{userId}/myWorkouts/{workoutId} {
      allow get, list: if signedIn() && request.auth.uid == userId;
      allow create, update: if signedIn() && request.auth.uid == userId && hasRole('user')
        && request.resource.data.keys().hasOnly(['name', 'category', 'description', 'estimatedTime', 'exercises', 'createdAt', 'updatedAt', 'source', 'photo', 'warmupStretch'])
        && (!('warmupStretch' in request.resource.data) || request.resource.data.warmupStretch is bool)   // etapa de alongamento antes do treino
        && (!('photo' in request.resource.data) || (request.resource.data.photo is string && request.resource.data.photo.size() <= 140000 && request.resource.data.photo.matches('^data:image/jpeg;base64,.*')))
        && request.resource.data.name is string && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 80
        && request.resource.data.exercises is list && request.resource.data.exercises.size() > 0 && request.resource.data.exercises.size() <= 30
        && request.resource.data.get('source', 'manual') in ['manual', 'pdf', 'ai']
        && request.resource.data.get('description', '') is string && request.resource.data.get('description', '').size() <= 300;
      allow delete: if signedIn() && request.auth.uid == userId;
    }

    // Exercícios criados pelo aluno: privados, reutilizáveis nos treinos pessoais. Só o dono lê e grava; foto = JPEG pequeno em data URL.
    match /users/{userId}/myExercises/{exerciseId} {
      allow get, list: if signedIn() && request.auth.uid == userId;
      allow create, update: if signedIn() && request.auth.uid == userId && hasRole('user')
        && request.resource.data.keys().hasOnly(['name', 'kind', 'muscleGroup', 'equipment', 'sets', 'reps', 'rest', 'note', 'photo', 'createdAt', 'updatedAt'])
        && request.resource.data.name is string && request.resource.data.name.size() > 1 && request.resource.data.name.size() <= 80
        && request.resource.data.kind in ['strength', 'timed', 'cardio']
        && request.resource.data.muscleGroup in ['peito', 'costas', 'ombros', 'biceps', 'triceps', 'pernas', 'gluteos', 'panturrilha', 'core', 'cardio', 'mobilidade']
        && request.resource.data.equipment in ['maquina', 'polia', 'halter', 'barra', 'livre', 'cardio']
        && request.resource.data.get('note', '') is string && request.resource.data.get('note', '').size() <= 160
        && (!('photo' in request.resource.data) || (request.resource.data.photo is string && request.resource.data.photo.size() <= 50000 && request.resource.data.photo.matches('^data:image/jpeg;base64,.*')));
      allow delete: if signedIn() && request.auth.uid == userId;
    }

    match /trainings/{trainingId} {
      // Current UI treats fichas as a shared catalog; do not store private data here.
      allow get, list: if signedIn();
      allow create: if validTraining(request.resource.data) && (
        isAdmin() || (
          ownsCoachTraining(request.resource.data)
          && request.resource.data.get('createdBy', request.auth.uid) == request.auth.uid
        ) || (hasRole('user') && ownsAITraining(request.resource.data))
      );
      allow update: if validTraining(request.resource.data)
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['coachId', 'createdBy', 'isAIGenerated'])
        && (isAdmin() || ownsCoachTraining(resource.data) || ownsAITraining(resource.data));
      allow delete: if isAdmin() || ownsCoachTraining(resource.data) || ownsAITraining(resource.data);
    }

    // Shared libraries retain the current coach/admin editorial model.
    // Notas privadas do treinador sobre um aluno: ID = coachId_studentId; o aluno nunca lê.
    // Resumo semanal do aluno (snapshot dos números e do texto). Só o dono lê e grava; id = uid_AAAA-Wss.
    match /weeklySummaries/{summaryId} {
      allow get: if signedIn() && (isAdmin() || summaryId.matches(request.auth.uid + '_[0-9]{4}-W[0-9]{2}'));
      allow list: if signedIn() && (isAdmin() || resource.data.uid == request.auth.uid);
      allow create, update: if signedIn() && summaryId == request.auth.uid + '_' + request.resource.data.weekKey
        && request.resource.data.keys().hasOnly(['uid', 'weekKey', 'factsHash', 'text', 'source', 'facts', 'updatedAt'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.weekKey.matches('^[0-9]{4}-W[0-9]{2}$')
        && request.resource.data.factsHash is string && request.resource.data.factsHash.size() <= 40
        && request.resource.data.text is string && request.resource.data.text.size() > 0 && request.resource.data.text.size() <= 800
        && request.resource.data.source in ['ai', 'local']
        && request.resource.data.facts is map && request.resource.data.updatedAt is string;
      allow delete: if signedIn() && (isAdmin() || resource.data.uid == request.auth.uid);
    }

    match /coachNotes/{noteId} {
      function validNote(data) {
        return data.keys().hasOnly(['coachId', 'studentId', 'text', 'updatedAt'])
          && data.coachId is string && data.studentId is string
          && noteId == data.coachId + '_' + data.studentId
          && data.text is string && data.text.size() <= 5000
          && data.updatedAt is string;
      }

      // O prefixo do ID prova a autoria mesmo quando o documento ainda não existe.
      allow get: if signedIn() && (isAdmin() || noteId.matches(request.auth.uid + '_.*'));
      allow create, update: if signedIn() && isCoach() && validNote(request.resource.data)
        && request.resource.data.coachId == request.auth.uid
        && linkedStudent(get(/databases/$(database)/documents/users/$(request.resource.data.studentId)).data);
      // O treinador autor e o admin apagam. O ALUNO sobre quem a nota fala só pode APAGAR (exclusão de conta):
      // ele continua sem poder ler nem listar o conteúdo (get/list não o permitem).
      allow delete: if signedIn() && (
        isAdmin() || noteId.matches(request.auth.uid + '_.*') || resource.data.studentId == request.auth.uid
      );
      allow list: if false;
    }

    // Histórico de alterações do painel administrativo: só o admin lê e acrescenta; nunca edita nem apaga.
    match /adminLog/{logId} {
      allow get, list: if isAdmin();
      allow create: if isAdmin()
        && request.resource.data.keys().hasOnly(['at', 'uid', 'action', 'target', 'targetId', 'name', 'detail'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.at is string
        && request.resource.data.action is string && request.resource.data.action.size() <= 40
        && request.resource.data.get('name', '') is string && request.resource.data.get('name', '').size() <= 200
        && request.resource.data.get('detail', '') is string && request.resource.data.get('detail', '').size() <= 500;
      allow update, delete: if false;
    }

    // ---- Social: amigos e ranking de consistência (sem dados de saúde) ----
    // Perfil público do aluno: só o que ele escolhe mostrar. `discoverable` libera a busca por nome;
    // `shareRanking` é a participação voluntária no ranking entre amigos.
    function publicProfileShape(d, uid) {
      return d.keys().hasOnly(['uid', 'displayName', 'displayNameLower', 'handle', 'photoURL', 'friendCode',
          'discoverable', 'shareRanking', 'shareWorkouts', 'weeklyGoal', 'updatedAt'])
        && d.uid == uid
        && d.displayName is string && d.displayName.size() > 0 && d.displayName.size() <= 60
        && d.displayNameLower is string && d.displayNameLower.size() <= 60
        && d.handle is string && d.handle.matches('^[a-z0-9_]{3,20}$')
        && d.friendCode is string && d.friendCode.matches('^[A-Z0-9]{8}$')
        && d.photoURL is string && d.photoURL == ''
        && d.discoverable is bool && d.shareRanking is bool && d.get('shareWorkouts', false) is bool
        && d.weeklyGoal is int && d.weeklyGoal >= 2 && d.weeklyGoal <= 7
        && d.updatedAt is string;
    }

    // @usuário e código de amigo são únicos: o documento de reserva precisa nascer no mesmo lote do perfil.
    function claims(uid, d) {
      return getAfter(/databases/$(database)/documents/handles/$(d.handle)).data.uid == uid
        && getAfter(/databases/$(database)/documents/friendCodes/$(d.friendCode)).data.uid == uid;
    }

    match /publicProfiles/{profileId} {
      allow get: if signedIn() && (request.auth.uid == profileId || isAdmin()
        || (!(exists(friendPath(request.auth.uid, profileId)) && get(friendPath(request.auth.uid, profileId)).data.status == 'blocked'
            && get(friendPath(request.auth.uid, profileId)).data.blockedBy != request.auth.uid)
          && (resource.data.discoverable == true
            || (exists(friendPath(request.auth.uid, profileId)) && get(friendPath(request.auth.uid, profileId)).data.status in ['active', 'pending']))));
      allow list: if isAdmin();   // a busca por nome usa profileSearch (só nome e @), nunca o perfil completo
      allow create: if signedIn() && request.auth.uid == profileId && publicProfileShape(request.resource.data, profileId)
        && claims(profileId, request.resource.data);
      allow update: if signedIn() && request.auth.uid == profileId && publicProfileShape(request.resource.data, profileId)
        && request.resource.data.friendCode == resource.data.friendCode
        && (request.resource.data.handle == resource.data.handle || claims(profileId, request.resource.data));
      allow delete: if signedIn() && request.auth.uid == profileId;
    }

    // Índice de busca por nome/@: só nome, @ e uid de quem escolheu ser encontrado (sem código de amigo nem preferências).
    // Escrito junto com o perfil público (mesmo lote) e só existe enquanto discoverable == true. Listas não consultam bloqueios
    // por documento: o app esconde quem bloqueou/foi bloqueado; o pedido de amizade continua barrado pelas regras de friendships.
    match /profileSearch/{profileId} {
      allow get: if false;
      allow list: if signedIn() && request.query.limit is int && request.query.limit <= 10;
      allow create, update: if signedIn() && request.auth.uid == profileId
        && request.resource.data.keys().hasOnly(['uid', 'displayName', 'displayNameLower', 'handle'])
        && request.resource.data.uid == profileId
        && request.resource.data.displayName is string && request.resource.data.displayName.size() > 0 && request.resource.data.displayName.size() <= 60
        && request.resource.data.displayNameLower is string && request.resource.data.displayNameLower.size() <= 60
        && request.resource.data.handle is string && request.resource.data.handle.matches('^[a-z0-9_]{3,20}$')
        && existsAfter(profilePath(profileId))
        && getAfter(profilePath(profileId)).data.discoverable == true
        && getAfter(profilePath(profileId)).data.handle == request.resource.data.handle;
      allow delete: if signedIn() && (request.auth.uid == profileId || isAdmin());
    }

    match /handles/{handle} {
      allow get: if signedIn();
      allow create: if signedIn() && handle.matches('^[a-z0-9_]{3,20}$')
        && request.resource.data.keys().hasOnly(['uid']) && request.resource.data.uid == request.auth.uid
        && getAfter(profilePath(request.auth.uid)).data.handle == handle;
      allow update: if false;
      allow delete: if signedIn() && resource.data.uid == request.auth.uid
        && (!existsAfter(profilePath(request.auth.uid)) || getAfter(profilePath(request.auth.uid)).data.handle != handle);
    }

    match /friendCodes/{code} {
      allow get: if signedIn();
      allow create: if signedIn() && code.matches('^[A-Z0-9]{8}$')
        && request.resource.data.keys().hasOnly(['uid']) && request.resource.data.uid == request.auth.uid
        && getAfter(profilePath(request.auth.uid)).data.friendCode == code;
      allow update: if false;
      allow delete: if signedIn() && resource.data.uid == request.auth.uid
        && (!existsAfter(profilePath(request.auth.uid)) || getAfter(profilePath(request.auth.uid)).data.friendCode != code);
    }

    // Amizade: um documento por par (ID = menor_maior). pending | active | blocked | removed.
    function friendshipShape(d, pairDocId) {
      return d.keys().hasOnly(['userA', 'userB', 'status', 'requestedBy', 'blockedBy', 'createdAt', 'updatedAt', 'declines', 'retryAfter'])
        && d.get('declines', 0) is int && d.get('declines', 0) >= 0 && d.get('declines', 0) <= 5
        && d.get('retryAfter', request.time) is timestamp
        && d.userA is string && d.userB is string && d.userA < d.userB
        && pairDocId == d.userA + '_' + d.userB
        && d.status in ['pending', 'active', 'blocked', 'removed']
        && d.requestedBy in [d.userA, d.userB]
        && d.createdAt is string && d.updatedAt is string
        && (d.status == 'blocked' ? ('blockedBy' in d && d.blockedBy in [d.userA, d.userB]) : !('blockedBy' in d));
    }
    function inPair(d) {
      return request.auth.uid == d.userA || request.auth.uid == d.userB;
    }
    // Recusas: cada recusa soma 1 e fixa uma espera (retryAfter) para quem pediu; nenhuma outra ação mexe nesses campos.
    function declinesUnchanged(next, old) {
      return next.get('declines', 0) == old.get('declines', 0) && next.get('retryAfter', null) == old.get('retryAfter', null);
    }
    function declineBump(next, old) {
      return next.get('declines', 0) == old.get('declines', 0) + 1
        && next.get('retryAfter', null) is timestamp && next.retryAfter >= request.time + duration.value(12, 'h')
        && next.retryAfter <= request.time + duration.value(48, 'h');
    }
    // Quem foi recusado só pede de novo depois da espera e até 3 recusas.
    function mayRerequest(old) {
      return old.requestedBy != request.auth.uid
        || (old.get('declines', 0) < 3 && (old.get('retryAfter', null) == null || request.time > old.retryAfter));
    }
    function sameBase(next, old) {
      return next.userA == old.userA && next.userB == old.userB && next.createdAt == old.createdAt;
    }

    match /friendships/{pairDocId} {
      allow get: if signedIn() && (isAdmin() || (resource == null ? (pairDocId.matches(request.auth.uid + '_.*') || pairDocId.matches('.*_' + request.auth.uid)) : inPair(resource.data)));
      allow list: if signedIn() && (isAdmin() || request.auth.uid == resource.data.userA || request.auth.uid == resource.data.userB);
      // Pedido novo: quem pede é o próprio usuário; só para quem tem perfil social.
      allow create: if signedIn() && friendshipShape(request.resource.data, pairDocId) && inPair(request.resource.data)
        && request.resource.data.status == 'pending' && request.resource.data.requestedBy == request.auth.uid
        && !('declines' in request.resource.data) && !('retryAfter' in request.resource.data)
        && exists(profilePath(request.auth.uid))
        && exists(profilePath(request.resource.data.userA == request.auth.uid ? request.resource.data.userB : request.resource.data.userA));
      allow update: if signedIn() && friendshipShape(request.resource.data, pairDocId) && inPair(resource.data)
        && sameBase(request.resource.data, resource.data) && (
          // aceitar: só quem recebeu o pedido
          (resource.data.status == 'pending' && request.resource.data.status == 'active'
            && resource.data.requestedBy != request.auth.uid && request.resource.data.requestedBy == resource.data.requestedBy
            && declinesUnchanged(request.resource.data, resource.data))
          // recusar (quem recebeu): soma uma recusa e fixa a espera
          || (resource.data.status == 'pending' && request.resource.data.status == 'removed'
            && resource.data.requestedBy != request.auth.uid && request.resource.data.requestedBy == resource.data.requestedBy
            && declineBump(request.resource.data, resource.data))
          // cancelar (quem pediu) o pedido; remover amigo (qualquer lado)
          || (((resource.data.status == 'pending' && resource.data.requestedBy == request.auth.uid) || resource.data.status == 'active')
            && request.resource.data.status == 'removed'
            && request.resource.data.requestedBy == resource.data.requestedBy && declinesUnchanged(request.resource.data, resource.data))
          // pedir de novo depois de removido (nunca depois de bloqueio), respeitando espera e limite de recusas
          || (resource.data.status == 'removed' && request.resource.data.status == 'pending'
            && request.resource.data.requestedBy == request.auth.uid && mayRerequest(resource.data)
            && declinesUnchanged(request.resource.data, resource.data))
          // bloquear (qualquer estado, exceto já bloqueado)
          || (resource.data.status != 'blocked' && request.resource.data.status == 'blocked'
            && request.resource.data.blockedBy == request.auth.uid && request.resource.data.requestedBy == resource.data.requestedBy
            && declinesUnchanged(request.resource.data, resource.data))
          // desbloquear: só quem bloqueou
          || (resource.data.status == 'blocked' && resource.data.blockedBy == request.auth.uid
            && request.resource.data.status == 'removed' && request.resource.data.requestedBy == resource.data.requestedBy
            && declinesUnchanged(request.resource.data, resource.data))
        );
      // Só a exclusão da própria conta (users/{uid} some no mesmo lote) ou o admin apagam amizades: quem foi recusado não
      // consegue apagar o documento para zerar a espera e o limite de recusas.
      allow delete: if isAdmin() || (signedIn() && inPair(resource.data)
        && !existsAfter(/databases/$(database)/documents/users/$(request.auth.uid)));
    }

    // Feed de amigos: o aluno que ativou "compartilhar treinos concluídos" publica um resumo SEM cargas, medidas ou fotos (nome do treino,
    // minutos, séries, exercícios, recordes e treinos da semana). Só amigos ativos (e o próprio autor) leem; bloqueio ou fim da amizade fecham o acesso.
    function postShape(d) {
      return d.keys().hasOnly(['authorId', 'kind', 'title', 'minutes', 'workSets', 'exercises', 'records', 'weekCount', 'createdAt'])
        && d.kind == 'workout'
        && d.title is string && d.title.size() > 0 && d.title.size() <= 60
        && d.minutes is int && d.minutes >= 1 && d.minutes <= 600
        && d.workSets is int && d.workSets >= 0 && d.workSets <= 300
        && d.exercises is int && d.exercises >= 1 && d.exercises <= 40
        && d.records is int && d.records >= 0 && d.records <= 40
        && d.weekCount is int && d.weekCount >= 0 && d.weekCount <= 14
        && d.createdAt is string && d.createdAt.size() <= 40 && d.createdAt.matches('^20[0-9][0-9]-[01][0-9]-[0-3][0-9]T.*');
    }
    function sharesWorkouts(uid) {
      return exists(profilePath(uid)) && get(profilePath(uid)).data.get('shareWorkouts', false) == true;
    }
    function activeFriends(a, b) {
      return exists(friendPath(a, b)) && get(friendPath(a, b)).data.status == 'active';
    }
    function canSeePost(authorId) {
      return request.auth.uid == authorId || (activeFriends(request.auth.uid, authorId) && sharesWorkouts(authorId));
    }
    match /socialPosts/{postId} {
      allow get, list: if signedIn() && (canSeePost(resource.data.authorId) || isAdmin());
      allow create: if signedIn() && hasRole('user') && postShape(request.resource.data)
        && request.resource.data.authorId == request.auth.uid && sharesWorkouts(request.auth.uid);
      allow update: if false;
      allow delete: if signedIn() && (resource.data.authorId == request.auth.uid || isAdmin());   // o admin remove post denunciado
      match /likes/{likerId} {
        allow get, list: if signedIn() && (isAdmin() || canSeePost(get(/databases/$(database)/documents/socialPosts/$(postId)).data.authorId));
        allow create: if signedIn() && likerId == request.auth.uid
          && request.resource.data.keys().hasOnly(['at', 'likerId']) && request.resource.data.likerId == request.auth.uid
          && request.resource.data.at is string && request.resource.data.at.size() <= 40
          && canSeePost(get(/databases/$(database)/documents/socialPosts/$(postId)).data.authorId);
        allow update: if false;
        allow delete: if signedIn() && (likerId == request.auth.uid || isAdmin()
          || get(/databases/$(database)/documents/socialPosts/$(postId)).data.authorId == request.auth.uid);
      }
      // Comentários: quem vê o post comenta; texto curto, sem links; sem edição. Apagam o autor do comentário, o do post e o admin.
      match /comments/{commentId} {
        allow get, list: if signedIn() && (isAdmin() || canSeePost(get(/databases/$(database)/documents/socialPosts/$(postId)).data.authorId));
        allow create: if signedIn() && hasRole('user')
          && request.resource.data.keys().hasOnly(['authorId', 'text', 'createdAt'])
          && request.resource.data.authorId == request.auth.uid
          && request.resource.data.text is string && request.resource.data.text.size() >= 1 && request.resource.data.text.size() <= 280
          && request.resource.data.text.matches('(?s).*[^\\s].*')
          && !request.resource.data.text.lower().matches('(?s).*(https?://|www[.]|[a-z0-9-]+[.][a-z]{2,}([/:?#]|\\b)).*')
          && request.resource.data.createdAt == request.time
          && canSeePost(get(/databases/$(database)/documents/socialPosts/$(postId)).data.authorId);
        allow update: if false;
        allow delete: if signedIn() && (resource.data.authorId == request.auth.uid || isAdmin()
          || get(/databases/$(database)/documents/socialPosts/$(postId)).data.authorId == request.auth.uid);
      }
    }

    // Denúncia de publicação: quem vê o post (amigo) denuncia uma vez; só o admin lê e decide. Sem texto livre.
    match /socialReports/{reportId} {
      allow get: if signedIn() && (isAdmin() || resource.data.reporterId == request.auth.uid);
      allow list: if signedIn() && (isAdmin() || resource.data.reporterId == request.auth.uid);
      // Denúncia de post (id denunciante_post) ou de comentário (id denunciante_post_comentário, authorId = autor do comentário).
      allow create: if signedIn() && hasRole('user')
        && request.resource.data.keys().hasOnly(['reporterId', 'postId', 'authorId', 'reason', 'createdAt', 'commentId'])
        && request.resource.data.reporterId == request.auth.uid
        && request.resource.data.reason in ['spam', 'ofensivo', 'improprio', 'outro']
        && request.resource.data.createdAt is string && request.resource.data.createdAt.size() <= 40
        && request.resource.data.authorId != request.auth.uid
        && exists(/databases/$(database)/documents/socialPosts/$(request.resource.data.postId))
        && canSeePost(get(/databases/$(database)/documents/socialPosts/$(request.resource.data.postId)).data.authorId)
        && (
          (!('commentId' in request.resource.data)
            && reportId == request.auth.uid + '_' + request.resource.data.postId
            && get(/databases/$(database)/documents/socialPosts/$(request.resource.data.postId)).data.authorId == request.resource.data.authorId)
          || (request.resource.data.commentId is string
            && reportId == request.auth.uid + '_' + request.resource.data.postId + '_' + request.resource.data.commentId
            && exists(/databases/$(database)/documents/socialPosts/$(request.resource.data.postId)/comments/$(request.resource.data.commentId))
            && get(/databases/$(database)/documents/socialPosts/$(request.resource.data.postId)/comments/$(request.resource.data.commentId)).data.authorId == request.resource.data.authorId)
        );
      // Dispensar mantém o registro (status), para a mesma pessoa não reabrir a denúncia em loop.
      allow update: if isAdmin() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])
        && request.resource.data.status == 'dismissed';
      allow delete: if signedIn() && (isAdmin() || resource.data.reporterId == request.auth.uid);
    }

    // Curtidas que o usuário deu (consulta por grupo de coleções, usada ao excluir a conta): só as próprias.
    // Atenção: qualquer subcoleção futura chamada 'likes' com campo likerId ficaria listável pelo próprio dono.
    match /{path=**}/likes/{likeId} {
      allow list: if signedIn() && resource.data.likerId == request.auth.uid;
    }

    // Comentários que o usuário fez (grupo de coleções, usado ao excluir a conta): só os próprios.
    // Atenção: qualquer subcoleção futura chamada 'comments' com campo authorId ficaria listável pelo próprio autor.
    match /{path=**}/comments/{commentId} {
      allow list: if signedIn() && resource.data.authorId == request.auth.uid;
    }

    // Registro das ações sociais (para a auditoria do admin). Cada usuário só acrescenta as próprias entradas.
    match /socialLog/{logId} {
      allow get: if isAdmin();
      allow list: if signedIn() && (isAdmin() || resource.data.uid == request.auth.uid);
      allow create: if signedIn() && request.resource.data.keys().hasOnly(['at', 'uid', 'action', 'other', 'pairId'])
        && request.resource.data.uid == request.auth.uid && request.resource.data.at is string
        && request.resource.data.action in ['pedir', 'aceitar', 'recusar', 'cancelar', 'remover', 'bloquear', 'desbloquear', 'entrar-ranking', 'sair-ranking']
        && request.resource.data.at.size() <= 40
        && request.resource.data.get('other', '') is string && request.resource.data.get('other', '').size() <= 128
        && request.resource.data.get('pairId', '') is string && request.resource.data.get('pairId', '').size() <= 300;
      allow update: if false;
      // Quem já apagou o próprio perfil social (exclusão de conta) pode apagar os próprios registros.
      allow delete: if signedIn() && resource.data.uid == request.auth.uid && !exists(profilePath(request.auth.uid));
    }

    // ---- Desafios em grupo (estilo GymRats, MVP): placar de dias ativos, sem chat e sem foto ----
    // challenges/{id}: nome, 7 ou 30 dias, início/fim (AAAA-MM-DD no fuso do aparelho), dono, código de 8 caracteres e contador de
    // membros (até 50). challengeCodes/{código} -> {challengeId} é o convite. Só membros leem o desafio e a lista de membros.
    // O placar (activeDays/lastDay) é publicado por cada membro a partir dos próprios check-ins: as regras só limitam o valor
    // (no máximo 1 dia ativo por dia de calendário, dentro do período, nunca no futuro, nunca diminui). NÃO é à prova de fraude:
    // um cliente adulterado consegue marcar dias sem treino dentro desses limites.
    function chPath(cid) {
      return /databases/$(database)/documents/challenges/$(cid);
    }
    function chMemberPath(cid, uid) {
      return /databases/$(database)/documents/challenges/$(cid)/members/$(uid);
    }
    function chCodePath(code) {
      return /databases/$(database)/documents/challengeCodes/$(code);
    }
    // Membro de um desafio que ainda existe (sobras de um desafio apagado não leem umas às outras).
    function chIsMember(cid) {
      return signedIn() && exists(chMemberPath(cid, request.auth.uid)) && exists(chPath(cid));
    }
    function chDayOk(s) {
      return s is string && s.matches('^20[0-9]{2}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])$');
    }
    // 'AAAA-MM-DD' -> meia-noite UTC desse dia (o dia local do aparelho fica entre -36 h e +14 h disso)
    function chDayTs(s) {
      return timestamp.date(int(s.split('-')[0]), int(s.split('-')[1]), int(s.split('-')[2]));
    }
    function chNotFuture(s) {
      return chDayTs(s) <= request.time + duration.value(14, 'h');
    }
    function challengeShape(d) {
      return d.keys().hasOnly(['name', 'durationDays', 'startDay', 'endDay', 'ownerId', 'code', 'memberCount', 'status', 'createdAt'])
        && d.name is string && d.name.size() >= 1 && d.name.size() <= 40 && d.name.matches('(?s).*[^\\s].*')
        && !d.name.lower().matches('(?s).*(https?://|www[.]|[a-z0-9-]+[.][a-z]{2,}([/:?#]|\\b)).*')
        && d.durationDays is int && d.durationDays in [7, 30]
        && chDayOk(d.startDay) && chDayOk(d.endDay)
        && chDayTs(d.endDay) == chDayTs(d.startDay) + duration.value(d.durationDays - 1, 'd')
        && d.ownerId is string
        && d.code is string && d.code.matches('^[A-Z0-9]{8}$')
        && d.memberCount is int && d.memberCount >= 0 && d.memberCount <= 50
        && d.status in ['active', 'ended']
        && d.createdAt is timestamp;
    }
    function chMemberShape(d, uid) {
      return d.keys().hasOnly(['uid', 'displayName', 'handle', 'code', 'joinedAt', 'activeDays', 'lastDay', 'updatedAt'])
        && d.uid == uid
        && d.displayName is string && d.displayName.size() >= 1 && d.displayName.size() <= 60
        && d.handle is string && d.handle.matches('^[a-z0-9_]{3,20}$')
        && d.code is string && d.code.matches('^[A-Z0-9]{8}$')
        && d.joinedAt is timestamp && d.updatedAt is timestamp
        && d.activeDays is int && d.activeDays >= 0 && d.activeDays <= 30
        && d.lastDay is string && (d.lastDay == '' || chDayOk(d.lastDay))
        && ((d.activeDays == 0) == (d.lastDay == ''));
    }
    // Nome e @ do membro são os do perfil social (ninguém entra com o nome de outra pessoa).
    function chProfileMatches(d) {
      return exists(profilePath(request.auth.uid))
        && get(profilePath(request.auth.uid)).data.displayName == d.displayName
        && get(profilePath(request.auth.uid)).data.handle == d.handle;
    }
    // Último dia contado antes desta gravação (sem nenhum: o dia anterior ao início).
    function chBase(old, ch) {
      return old.lastDay == '' ? chDayTs(ch.startDay) - duration.value(1, 'd') : chDayTs(old.lastDay);
    }
    // Placar: só sobe, e cada dia novo exige um dia de calendário a mais em lastDay (no máximo 1 por dia),
    // com lastDay dentro do período e não no futuro. Assim activeDays <= dias decorridos do desafio.
    function chScoreOk(d, old, ch) {
      return d.activeDays >= old.activeDays
        && (d.activeDays == old.activeDays
          ? d.lastDay == old.lastDay
          : (ch.status == 'active'
            && d.lastDay >= ch.startDay && d.lastDay <= ch.endDay && chNotFuture(d.lastDay)
            && (chDayTs(d.lastDay) - chBase(old, ch)).seconds() >= (d.activeDays - old.activeDays) * 86400));
    }

    match /challenges/{challengeId} {
      allow get: if chIsMember(challengeId);
      allow list: if false;
      // Criar: o dono entra como primeiro membro e reserva o código no mesmo lote; o início é "hoje" no fuso do aparelho.
      allow create: if signedIn() && challengeShape(request.resource.data)
        && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.memberCount == 1 && request.resource.data.status == 'active'
        && request.resource.data.createdAt == request.time
        && chDayTs(request.resource.data.startDay) >= request.time - duration.value(36, 'h')
        && chNotFuture(request.resource.data.startDay)
        && existsAfter(chMemberPath(challengeId, request.auth.uid))
        && getAfter(chCodePath(request.resource.data.code)).data.challengeId == challengeId;
      allow update: if signedIn() && challengeShape(request.resource.data) && (
          // entrar: só o contador sobe 1, junto com o próprio documento de membro (o limite de 50 está no formato)
          (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['memberCount'])
            && request.resource.data.memberCount == resource.data.memberCount + 1
            && resource.data.status == 'active'
            && !exists(chMemberPath(challengeId, request.auth.uid)) && existsAfter(chMemberPath(challengeId, request.auth.uid)))
          // sair: o contador desce 1 junto com a saída (o dono não sai: encerra ou apaga)
          || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['memberCount'])
            && request.resource.data.memberCount == resource.data.memberCount - 1
            && resource.data.ownerId != request.auth.uid
            && exists(chMemberPath(challengeId, request.auth.uid)) && !existsAfter(chMemberPath(challengeId, request.auth.uid)))
          // encerrar: só o dono; o placar congela e ninguém mais entra
          || (resource.data.ownerId == request.auth.uid && resource.data.status == 'active'
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])
            && request.resource.data.status == 'ended')
        );
      // Apagar: só o dono, liberando o código no mesmo lote (o app apaga os membros no mesmo lote também).
      allow delete: if signedIn() && resource.data.ownerId == request.auth.uid
        && !existsAfter(chCodePath(resource.data.code));

      match /members/{memberId} {
        allow get: if signedIn() && (memberId == request.auth.uid || chIsMember(challengeId));
        allow list: if chIsMember(challengeId);
        allow create: if signedIn() && memberId == request.auth.uid
          && chMemberShape(request.resource.data, memberId)
          && request.resource.data.joinedAt == request.time && request.resource.data.updatedAt == request.time
          && request.resource.data.activeDays == 0 && request.resource.data.lastDay == ''
          && chProfileMatches(request.resource.data)
          && getAfter(chPath(challengeId)).data.code == request.resource.data.code
          && (
            // criação do desafio pelo dono (mesmo lote)
            (!exists(chPath(challengeId)) && getAfter(chPath(challengeId)).data.ownerId == request.auth.uid)
            // entrar pelo código: desafio ativo, ainda não terminado, e o contador sobe junto
            || (exists(chPath(challengeId))
              && get(chPath(challengeId)).data.status == 'active'
              && chDayTs(get(chPath(challengeId)).data.endDay) + duration.value(36, 'h') >= request.time
              && getAfter(chPath(challengeId)).data.memberCount == get(chPath(challengeId)).data.memberCount + 1)
          );
        // Cada membro atualiza só o próprio placar (e o nome/@ quando o perfil social mudou).
        allow update: if signedIn() && memberId == request.auth.uid
          && chMemberShape(request.resource.data, memberId)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['displayName', 'handle', 'activeDays', 'lastDay', 'updatedAt'])
          && request.resource.data.updatedAt == request.time
          && ((request.resource.data.displayName == resource.data.displayName && request.resource.data.handle == resource.data.handle)
            || chProfileMatches(request.resource.data))
          && chScoreOk(request.resource.data, resource.data, get(chPath(challengeId)).data);
        allow delete: if signedIn() && (
            // sair: o contador do desafio desce no mesmo lote; o dono não sai
            (memberId == request.auth.uid && exists(chPath(challengeId))
              && get(chPath(challengeId)).data.ownerId != request.auth.uid
              && getAfter(chPath(challengeId)).data.memberCount == get(chPath(challengeId)).data.memberCount - 1)
            // o dono apaga o desafio inteiro (o desafio some no mesmo lote)
            || (exists(chPath(challengeId)) && get(chPath(challengeId)).data.ownerId == request.auth.uid
              && !existsAfter(chPath(challengeId)))
            // sobra de um desafio que não existe mais: cada um apaga a própria
            || (memberId == request.auth.uid && !exists(chPath(challengeId)))
          );
      }
    }

    // Convite: quem sabe o código descobre o ID do desafio e entra (o membro também grava o código, conferido com o do desafio).
    match /challengeCodes/{code} {
      allow get: if signedIn();
      allow list: if false;
      allow create: if signedIn() && code.matches('^[A-Z0-9]{8}$')
        && request.resource.data.keys().hasOnly(['challengeId'])
        && request.resource.data.challengeId is string && request.resource.data.challengeId.size() <= 40
        && !exists(chPath(request.resource.data.challengeId))
        && getAfter(chPath(request.resource.data.challengeId)).data.ownerId == request.auth.uid
        && getAfter(chPath(request.resource.data.challengeId)).data.code == code;
      allow update: if false;
      allow delete: if signedIn() && (!exists(chPath(resource.data.challengeId))
        || get(chPath(resource.data.challengeId)).data.ownerId == request.auth.uid);
    }

    // Desafios de que o usuário participa (grupo de coleções, usado na lista e na exclusão da conta): só os próprios documentos.
    // Atenção: qualquer subcoleção futura chamada 'members' com campo uid ficaria listável pelo próprio dono.
    match /{path=**}/members/{memberId} {
      allow list: if signedIn() && resource.data.uid == request.auth.uid;
    }

    match /exercises/{docId} {
      allow get, list: if signedIn();
      allow create, update, delete: if isCoach() || isAdmin();
    }

    match /trainingPackages/{docId} {
      allow get, list: if signedIn();
      allow create, update, delete: if isCoach() || isAdmin();
    }

    // =====================================================================================================================
    // V2: ACADEMIAS (docs/V2_ACADEMIAS.md). Papel dentro da academia NUNCA altera users.role. IDs determinísticos
    // (academyId_userId) para as regras precisarem de poucos get(); academyId é minúsculo/alfanumérico, sem "_".
    // Toda mudança administrativa grava o registro de auditoria NO MESMO LOTE (acLogged confere por getAfter).
    // =====================================================================================================================
    function acMemberPath(aid, uid) {
      return /databases/$(database)/documents/academyMembers/$(aid + '_' + uid);
    }
    function acAssignPath(aid, sid) {
      return /databases/$(database)/documents/academyAssignments/$(aid + '_' + sid);
    }
    function acStatsPath(aid, uid) {
      return /databases/$(database)/documents/academyMemberStats/$(aid + '_' + uid);
    }
    function acSeriesPath(seriesId) {
      return /databases/$(database)/documents/trainingSeries/$(seriesId);
    }
    function acLogPath(logId) {
      return /databases/$(database)/documents/academyAuditLog/$(logId);
    }
    function acInvitePath(inviteId) {
      return /databases/$(database)/documents/academyInvites/$(inviteId);
    }
    function acAcademyPath(aid) {
      return /databases/$(database)/documents/academies/$(aid);
    }
    function acActive(aid) {
      return signedIn() && exists(acMemberPath(aid, request.auth.uid))
        && get(acMemberPath(aid, request.auth.uid)).data.status == 'active'
        && get(acAcademyPath(aid)).data.status == 'active';
    }
    function acRole(aid) {
      return get(acMemberPath(aid, request.auth.uid)).data.role;
    }
    function acStaff(aid) {
      return acActive(aid) && acRole(aid) in ['owner', 'admin'];
    }
    function acOwner(aid) {
      return acActive(aid) && acRole(aid) == 'owner';
    }
    function acIsStudent(aid, uid) {
      return exists(acMemberPath(aid, uid)) && get(acMemberPath(aid, uid)).data.status == 'active'
        && get(acMemberPath(aid, uid)).data.role == 'student';
    }
    // Professor responsável DE FATO: atribuição ativa (aceita pelo aluno) + os dois membros ativos.
    function acTeacherOf(aid, sid) {
      return signedIn() && acCanTeach(aid, request.auth.uid) && exists(acAssignPath(aid, sid))
        && get(acAssignPath(aid, sid)).data.teacherId == request.auth.uid
        && get(acAssignPath(aid, sid)).data.status == 'active'
        && acIsStudent(aid, sid);
    }
    function acCanTeach(aid, uid) {
      return exists(acMemberPath(aid, uid)) && get(acMemberPath(aid, uid)).data.status == 'active'
        && get(acMemberPath(aid, uid)).data.role in ['teacher', 'admin', 'owner'];
    }
    // Registro de auditoria criado no mesmo lote, do mesmo ator, da mesma academia, com a ação e o alvo esperados.
    function acLogged(aid, auditId, action, targetId) {
      return auditId is string && !exists(acLogPath(auditId)) && existsAfter(acLogPath(auditId))
        && getAfter(acLogPath(auditId)).data.academyId == aid
        && getAfter(acLogPath(auditId)).data.actorId == request.auth.uid
        && getAfter(acLogPath(auditId)).data.action == action
        && getAfter(acLogPath(auditId)).data.targetId == targetId;
    }
    // Encerrar atribuição: aceita o registro 'assignment.ended' ou o 'member.joined' do mesmo lote (aluno que volta à academia).
    function acLoggedEnded(aid, auditId, sid) {
      return auditId is string && !exists(acLogPath(auditId)) && existsAfter(acLogPath(auditId))
        && getAfter(acLogPath(auditId)).data.academyId == aid
        && getAfter(acLogPath(auditId)).data.actorId == request.auth.uid
        && getAfter(acLogPath(auditId)).data.action in ['assignment.ended', 'member.joined']
        && getAfter(acLogPath(auditId)).data.targetId == sid;
    }
    // Convite válido e com 1 uso somado no mesmo lote (mesmo desenho de coachInvites).
    function acInviteUsable(inviteId, aid, role) {
      return inviteId is string && exists(acInvitePath(inviteId))
        && get(acInvitePath(inviteId)).data.academyId == aid
        && get(acInvitePath(inviteId)).data.role == role
        && get(acInvitePath(inviteId)).data.revoked == false
        && get(acInvitePath(inviteId)).data.expiresAt > request.time
        && get(acInvitePath(inviteId)).data.uses < get(acInvitePath(inviteId)).data.maxUses
        && getAfter(acInvitePath(inviteId)).data.uses == get(acInvitePath(inviteId)).data.uses + 1;
    }
    function acAssignableRole(aid, role) {
      return (acRole(aid) == 'owner' && role in ['admin', 'teacher', 'reception', 'student'])
        || (acRole(aid) == 'admin' && role in ['teacher', 'reception', 'student']);
    }

    // Quem pode registrar cada ação: ações da equipe só pela equipe; ações do próprio membro só sobre si mesmo.
    function acLogActionAllowed(d, logId) {
      return (d.action == 'academy.created' && getAfter(acMemberPath(d.academyId, request.auth.uid)).data.role == 'owner')
        || (d.action in ['academy.updated', 'invite.created', 'invite.revoked', 'assignment.proposed', 'assignment.transferred']
          && acStaff(d.academyId))
        // o registro diz o que mudou: "papel,status" finais do membro-alvo, e a regra confere com o documento gravado
        || (d.action == 'member.updated' && acStaff(d.academyId)
          && d.get('detail', '') == getAfter(acMemberPath(d.academyId, d.targetId)).data.role + ',' + getAfter(acMemberPath(d.academyId, d.targetId)).data.status)
        || (d.action in ['member.joined', 'member.left', 'assignment.accepted'] && d.targetId == request.auth.uid)
        || (d.action == 'member.consent' && d.targetId == request.auth.uid
          && d.get('detail', '') == (getAfter(acMemberPath(d.academyId, request.auth.uid)).data.consent.adherence ? 'concedido' : 'revogado'))
        || (d.action == 'assignment.ended' && acActive(d.academyId))
        || (d.action in ['training.created', 'training.updated', 'training.published', 'training.archived', 'training.restored'] && acCanAuthor(d.academyId)
          && existsAfter(acSeriesPath(d.targetId)) && getAfter(acSeriesPath(d.targetId)).data.academyId == d.academyId
          && getAfter(acSeriesPath(d.targetId)).data.auditId == logId)
        // excluir: só autor, e a ficha não pode existir depois do lote (o ID del_<ficha> não é "queimável" por um registro solto)
        || (d.action == 'training.deleted' && acCanAuthor(d.academyId) && logId == 'del_' + d.targetId && !existsAfter(acSeriesPath(d.targetId)))
        || (d.action == 'training.assigned' && existsAfter(acAssignedTrainingPath(d.academyId, d.targetId))
          && getAfter(acAssignedTrainingPath(d.academyId, d.targetId)).data.auditId == logId
          && (acStaff(d.academyId) || acTeacherOf(d.academyId, d.targetId)))
        || (d.action == 'training.unassigned' && acActive(d.academyId) && acRole(d.academyId) in ['owner', 'admin', 'teacher']);
    }

    match /academyAuditLog/{logId} {
      allow get, list: if signedIn() && (isAdmin() || acStaff(resource.data.academyId));
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['academyId', 'actorId', 'action', 'targetType', 'targetId', 'at', 'detail'])
        && request.resource.data.actorId == request.auth.uid
        && request.resource.data.academyId is string && request.resource.data.academyId.matches('^[a-z0-9]{16,28}$')
        && request.resource.data.at == request.time
        && request.resource.data.action in ['academy.created', 'academy.updated', 'member.joined', 'member.left', 'member.updated',
          'member.consent', 'invite.created', 'invite.revoked', 'assignment.proposed', 'assignment.accepted', 'assignment.ended',
          'assignment.transferred', 'training.created', 'training.updated', 'training.published', 'training.archived', 'training.restored', 'training.deleted', 'training.assigned', 'training.unassigned']
        && request.resource.data.targetType in ['academy', 'member', 'invite', 'assignment', 'training']
        && request.resource.data.targetId is string && request.resource.data.targetId.size() > 0 && request.resource.data.targetId.size() <= 120
        && request.resource.data.get('detail', '') is string && request.resource.data.get('detail', '').size() <= 200
        // só quem é (ou está entrando como) membro da academia registra; ex-membro e estranho não conseguem
        && (getAfter(acMemberPath(request.resource.data.academyId, request.auth.uid)).data.status == 'active'
          || (request.resource.data.action == 'member.left'
            && getAfter(acMemberPath(request.resource.data.academyId, request.auth.uid)).data.status == 'left'))
        && acLogActionAllowed(request.resource.data, logId);
      allow update, delete: if false;
    }

    match /academies/{academyId} {
      allow get: if signedIn() && (isAdmin() || acActive(academyId));
      allow list: if isAdmin();
      allow create: if signedIn() && academyId.matches('^[a-z0-9]{16,28}$')
        && request.resource.data.keys().hasOnly(['name', 'ownerId', 'status', 'createdAt', 'updatedAt', 'auditId'])
        && request.resource.data.ownerId == request.auth.uid && request.resource.data.status == 'active'
        && request.resource.data.name is string && request.resource.data.name.size() >= 2 && request.resource.data.name.size() <= 80
        && request.resource.data.createdAt is string && request.resource.data.updatedAt is string
        && getAfter(acMemberPath(academyId, request.auth.uid)).data.role == 'owner'
        && getAfter(acMemberPath(academyId, request.auth.uid)).data.status == 'active'
        && acLogged(academyId, request.resource.data.auditId, 'academy.created', academyId);
      // Proprietário e admin editam só o nome; propriedade e status ficam travados (suporte do produto muda o status).
      allow update: if signedIn() && (
        (acStaff(academyId) && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'updatedAt', 'auditId'])
          && request.resource.data.name is string && request.resource.data.name.size() >= 2 && request.resource.data.name.size() <= 80
          && acLogged(academyId, request.resource.data.auditId, 'academy.updated', academyId))
        || (isAdmin() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'updatedAt'])
          && request.resource.data.status in ['active', 'suspended']));
      allow delete: if false;
    }

    match /academyMembers/{memberId} {
      allow get: if signedIn() && (isAdmin() || (resource == null
        ? memberId.matches('^[a-z0-9]{16,28}_' + request.auth.uid + '$')
        : (resource.data.userId == request.auth.uid || acStaff(resource.data.academyId)
          || acTeacherOf(resource.data.academyId, resource.data.userId))));
      allow list: if signedIn() && (isAdmin() || resource.data.userId == request.auth.uid || acStaff(resource.data.academyId));

      allow create: if signedIn() && request.resource.data.keys().hasOnly(['academyId', 'userId', 'role', 'status', 'displayName',
          'inviteId', 'consent', 'perms', 'auditId', 'createdAt', 'updatedAt'])
        && memberId == request.resource.data.academyId + '_' + request.resource.data.userId
        && request.resource.data.userId == request.auth.uid && request.resource.data.status == 'active'
        && request.resource.data.displayName is string && request.resource.data.displayName.size() <= 80
        && request.resource.data.consent is map && request.resource.data.consent.keys().hasOnly(['adherence'])
        && request.resource.data.consent.adherence is bool && !('perms' in request.resource.data)
        && request.resource.data.createdAt is string && request.resource.data.updatedAt is string
        && (
          // (A) criação da academia: o criador é o proprietário
          (request.resource.data.role == 'owner' && !('inviteId' in request.resource.data)
            && existsAfter(acAcademyPath(request.resource.data.academyId)) && !exists(acAcademyPath(request.resource.data.academyId))
            && getAfter(acAcademyPath(request.resource.data.academyId)).data.ownerId == request.auth.uid
            && acLogged(request.resource.data.academyId, request.resource.data.auditId, 'academy.created', request.resource.data.academyId))
          // (B) entrada por convite: papel do convite (nunca owner), 1 uso somado no mesmo lote
          || (request.resource.data.role in ['admin', 'teacher', 'reception', 'student']
            && acInviteUsable(request.resource.data.inviteId, request.resource.data.academyId, request.resource.data.role)
            && acLogged(request.resource.data.academyId, request.resource.data.auditId, 'member.joined', request.auth.uid))
        );

      allow update: if signedIn() && request.resource.data.academyId == resource.data.academyId
        && request.resource.data.userId == resource.data.userId && memberId == request.resource.data.academyId + '_' + request.resource.data.userId
        && request.resource.data.createdAt == resource.data.createdAt && (
          // (S1) o próprio membro sai da academia (o proprietário não sai)
          (resource.data.userId == request.auth.uid && resource.data.status == 'active' && resource.data.role != 'owner'
            && request.resource.data.status == 'left' && request.resource.data.role == resource.data.role
            && request.resource.data.consent.adherence == false
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'consent', 'updatedAt', 'auditId'])
            && !existsAfter(acStatsPath(resource.data.academyId, resource.data.userId))
            && acLogged(resource.data.academyId, request.resource.data.auditId, 'member.left', request.auth.uid))
          // (S2) quem saiu volta com um convite novo e válido (removido ou suspenso NÃO volta sozinho)
          || (resource.data.userId == request.auth.uid && resource.data.status == 'left' && resource.data.role != 'owner'
            && request.resource.data.status == 'active' && request.resource.data.role in ['admin', 'teacher', 'reception', 'student']
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'role', 'inviteId', 'consent', 'displayName', 'updatedAt', 'auditId'])
            && request.resource.data.displayName is string && request.resource.data.displayName.size() <= 80
            && request.resource.data.consent is map && request.resource.data.consent.keys().hasOnly(['adherence'])
            && request.resource.data.consent.adherence is bool
            && (!exists(acAssignPath(resource.data.academyId, resource.data.userId))
              || getAfter(acAssignPath(resource.data.academyId, resource.data.userId)).data.status == 'ended')
            && acInviteUsable(request.resource.data.inviteId, resource.data.academyId, request.resource.data.role)
            && acLogged(resource.data.academyId, request.resource.data.auditId, 'member.joined', request.auth.uid))
          // (S3) nome e consentimento; revogar a aderência exige apagar o status no mesmo lote
          || (resource.data.userId == request.auth.uid && resource.data.status == 'active'
            && request.resource.data.status == 'active' && request.resource.data.role == resource.data.role
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['displayName', 'consent', 'updatedAt', 'auditId'])
            && request.resource.data.displayName is string && request.resource.data.displayName.size() <= 80
            && request.resource.data.consent is map && request.resource.data.consent.keys().hasOnly(['adherence'])
            && request.resource.data.consent.adherence is bool
            && (request.resource.data.consent.adherence == true || !existsAfter(acStatsPath(resource.data.academyId, resource.data.userId)))
            && acLogged(resource.data.academyId, request.resource.data.auditId, 'member.consent', request.auth.uid))
          // (T) proprietário/admin gerenciam papel, status e permissões de quem está abaixo deles (nunca de si nem do proprietário)
          || (acStaff(resource.data.academyId) && resource.data.userId != request.auth.uid && resource.data.role != 'owner'
            && resource.data.status != 'left'
            && (acRole(resource.data.academyId) == 'owner' || resource.data.role != 'admin')
            && request.resource.data.role != 'owner'
            && (request.resource.data.role == resource.data.role || acAssignableRole(resource.data.academyId, request.resource.data.role))
            && request.resource.data.status in ['active', 'suspended', 'removed']
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['role', 'status', 'perms', 'updatedAt', 'auditId'])
            && (!('perms' in request.resource.data) || (request.resource.data.perms is map
              && request.resource.data.perms.keys().hasOnly(['createTrainings'])
              && request.resource.data.perms.get('createTrainings', false) is bool))
            && acLogged(resource.data.academyId, request.resource.data.auditId, 'member.updated', resource.data.userId))
        );
      allow delete: if false;
    }

    match /academyInvites/{inviteId} {
      // O ID é segredo (só vale com o link). O documento não tem dado pessoal.
      allow get: if true;
      allow list: if signedIn() && (isAdmin() || acStaff(resource.data.academyId));
      allow create: if signedIn() && inviteId.matches('^ai_[A-Za-z0-9]{20}$')
        && request.resource.data.keys().hasOnly(['academyId', 'academyName', 'role', 'expiresAt', 'maxUses', 'uses', 'revoked',
          'createdBy', 'createdAt', 'auditId'])
        && acStaff(request.resource.data.academyId) && acAssignableRole(request.resource.data.academyId, request.resource.data.role)
        && request.resource.data.academyName == get(acAcademyPath(request.resource.data.academyId)).data.name
        && request.resource.data.createdBy == request.auth.uid && request.resource.data.createdAt is string
        && request.resource.data.uses == 0 && request.resource.data.revoked == false
        && request.resource.data.maxUses is int && request.resource.data.maxUses >= 1
        && request.resource.data.maxUses <= (request.resource.data.role == 'admin' ? 5 : 200)
        && request.resource.data.expiresAt is timestamp
        && request.resource.data.expiresAt >= request.time + duration.value(1, 'h')
        && request.resource.data.expiresAt <= request.time + duration.value(31, 'd')
        && acLogged(request.resource.data.academyId, request.resource.data.auditId, 'invite.created', inviteId);
      allow update: if signedIn() && (
        // revogar (só a equipe da academia dona do convite)
        (acStaff(resource.data.academyId) && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['revoked', 'auditId'])
          && request.resource.data.revoked == true
          && acLogged(resource.data.academyId, request.resource.data.auditId, 'invite.revoked', inviteId))
        // uso: 1 por vez, junto da criação/reativação do próprio membro com este convite
        || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['uses'])
          && request.resource.data.uses == resource.data.uses + 1 && request.resource.data.uses <= resource.data.maxUses
          && resource.data.revoked == false && resource.data.expiresAt > request.time
          && (!exists(acMemberPath(resource.data.academyId, request.auth.uid))
            || get(acMemberPath(resource.data.academyId, request.auth.uid)).data.status == 'left')
          && getAfter(acMemberPath(resource.data.academyId, request.auth.uid)).data.inviteId == inviteId
          && getAfter(acMemberPath(resource.data.academyId, request.auth.uid)).data.status == 'active'
          && getAfter(acMemberPath(resource.data.academyId, request.auth.uid)).data.role == resource.data.role));
      allow delete: if false;
    }

    match /academyAssignments/{assignId} {
      allow get: if signedIn() && (isAdmin() || (resource == null
        ? assignId.matches('^[a-z0-9]{16,28}_' + request.auth.uid + '$')
        : (resource.data.studentId == request.auth.uid
          || (resource.data.teacherId == request.auth.uid && resource.data.status == 'active')
          || acStaff(resource.data.academyId))));
      // Professor só enxerga a atribuição depois do aceite (a consulta precisa filtrar status == 'active').
      allow list: if signedIn() && (isAdmin() || resource.data.studentId == request.auth.uid
        || (resource.data.teacherId == request.auth.uid && resource.data.status == 'active') || acStaff(resource.data.academyId));
      // Proposta da equipe: professor elegível + aluno ativo; sem aceite do aluno o professor não lê nada.
      allow create: if signedIn() && request.resource.data.keys().hasOnly(['academyId', 'studentId', 'teacherId', 'status',
          'requestedBy', 'previousTeacherId', 'teacherName', 'auditId', 'createdAt', 'updatedAt'])
        && request.resource.data.teacherName is string && request.resource.data.teacherName.size() <= 80
        && assignId == request.resource.data.academyId + '_' + request.resource.data.studentId
        && acStaff(request.resource.data.academyId) && request.resource.data.requestedBy == request.auth.uid
        && request.resource.data.status == 'pending'
        && acCanTeach(request.resource.data.academyId, request.resource.data.teacherId)
        && acIsStudent(request.resource.data.academyId, request.resource.data.studentId)
        && request.resource.data.createdAt is string && request.resource.data.updatedAt is string
        && acLogged(request.resource.data.academyId, request.resource.data.auditId, 'assignment.proposed', request.resource.data.studentId);
      allow update: if signedIn() && request.resource.data.academyId == resource.data.academyId
        && request.resource.data.studentId == resource.data.studentId
        && assignId == request.resource.data.academyId + '_' + request.resource.data.studentId
        && request.resource.data.createdAt == resource.data.createdAt && (
          // o ALUNO aceita
          (resource.data.studentId == request.auth.uid && resource.data.status == 'pending' && request.resource.data.status == 'active'
            && request.resource.data.teacherId == resource.data.teacherId
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'updatedAt', 'auditId'])
            && acIsStudent(resource.data.academyId, request.auth.uid) && acCanTeach(resource.data.academyId, resource.data.teacherId)
            && acLogged(resource.data.academyId, request.resource.data.auditId, 'assignment.accepted', resource.data.studentId))
          // aluno, professor ou equipe encerram (o acesso do professor acaba na hora)
          || ((resource.data.studentId == request.auth.uid || resource.data.teacherId == request.auth.uid || acStaff(resource.data.academyId))
            && resource.data.status in ['pending', 'active'] && request.resource.data.status == 'ended'
            && request.resource.data.teacherId == resource.data.teacherId
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'updatedAt', 'auditId'])
            && acLoggedEnded(resource.data.academyId, request.resource.data.auditId, resource.data.studentId))
          // a equipe propõe de novo (depois de encerrada) ou TRANSFERE para outro professor: volta a pendente, exige novo aceite
          || (acStaff(resource.data.academyId) && request.resource.data.status == 'pending'
            && request.resource.data.requestedBy == request.auth.uid
            && request.resource.data.previousTeacherId == resource.data.teacherId
            && acCanTeach(resource.data.academyId, request.resource.data.teacherId)
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['teacherId', 'teacherName', 'status', 'requestedBy', 'previousTeacherId', 'updatedAt', 'auditId'])
            && request.resource.data.teacherName is string && request.resource.data.teacherName.size() <= 80
            && acLogged(resource.data.academyId, request.resource.data.auditId,
              resource.data.status == 'active' ? 'assignment.transferred' : 'assignment.proposed', resource.data.studentId))
        );
      allow delete: if false;
    }

    // Aderência do aluno (validUntil + último check-in), legível só por ele na V2.0. Sem cargas, medidas nem histórico.
    match /academyMemberStats/{statsId} {
      // V2.0: só o próprio aluno lê. Equipe e professor NÃO leem (validUntil revelaria a data do último treino); a aderência
      // individual na academia só volta na V2.1, com agregador no servidor que publica apenas em_dia/atrasado/sem_dados.
      allow get: if signedIn() && (isAdmin() || (resource != null && resource.data.userId == request.auth.uid));
      // sem list para a equipe: o consentimento mora em outro documento; a equipe lê aluno a aluno (get)
      allow list: if signedIn() && (isAdmin() || resource.data.userId == request.auth.uid);
      allow create, update: if signedIn() && request.resource.data.keys().hasOnly(['academyId', 'userId', 'validUntil', 'lastCheckInId', 'updatedAt'])
        && statsId == request.resource.data.academyId + '_' + request.resource.data.userId
        && request.resource.data.userId == request.auth.uid
        && acIsStudent(request.resource.data.academyId, request.auth.uid)
        && get(acMemberPath(request.resource.data.academyId, request.auth.uid)).data.consent.adherence == true
        && request.resource.data.validUntil is timestamp && request.resource.data.validUntil > request.time
        && request.resource.data.validUntil <= request.time + duration.value(7, 'd') + duration.value(1, 'h')
        && request.resource.data.lastCheckInId is string
        && request.resource.data.lastCheckInId == get(/databases/$(database)/documents/userStats/$(request.auth.uid)).data.lastCheckInId
        && request.resource.data.updatedAt is string
        && (resource == null || request.resource.data.lastCheckInId != resource.data.lastCheckInId);
      // Apagar o que não existe também é permitido ao dono do ID (sair/revogar sem aderência publicada não pode falhar).
      allow delete: if signedIn() && (resource == null
        ? statsId.matches('^[a-z0-9]{16,28}_' + request.auth.uid + '$')
        : (resource.data.userId == request.auth.uid
          || (acStaff(resource.data.academyId) && getAfter(acMemberPath(resource.data.academyId, resource.data.userId)).data.status in ['removed', 'suspended', 'left'])));
    }

    // Fichas versionadas da academia: série + versões imutáveis. Atribuição fixa a versão.
    function acCanAuthor(aid) {
      return acActive(aid) && (acRole(aid) in ['owner', 'admin']
        || (acRole(aid) == 'teacher' && get(acMemberPath(aid, request.auth.uid)).data.get('perms', {}).get('createTrainings', false) == true));
    }
    function acTrainingVersionPath(seriesId, n) {
      return /databases/$(database)/documents/trainingVersions/$(seriesId + '_' + string(n));
    }
    function acAssignedTrainingPath(aid, sid) {
      return /databases/$(database)/documents/academyAssigned/$(aid + '_' + sid);
    }
    // Cada exercício da ficha é um mapa com campos permitidos. Validar tipo/tamanho dos campos por item estoura o limite de 1000 expressões
    // das regras (medido: com o nome já não cabem 20 exercícios); tipos e tamanhos ficam na tela (que trata o conteúdo de forma defensiva)
    // e no tamanho máximo do documento. Só autores (dono, admin, professor com permissão) escrevem.
    function exOk(e) {
      return e is map && e.keys().hasOnly(['name', 'muscleGroup', 'sets', 'reps', 'rest', 'machineImage']);
    }
    function exAt(l, i) {
      return l.size() <= i || exOk(l[i]);
    }
    function validExercises(l) {
      return l is list && l.size() <= 20
        && exAt(l, 0) && exAt(l, 1) && exAt(l, 2) && exAt(l, 3) && exAt(l, 4) && exAt(l, 5) && exAt(l, 6) && exAt(l, 7) && exAt(l, 8) && exAt(l, 9)
        && exAt(l, 10) && exAt(l, 11) && exAt(l, 12) && exAt(l, 13) && exAt(l, 14) && exAt(l, 15) && exAt(l, 16) && exAt(l, 17) && exAt(l, 18) && exAt(l, 19);
    }
    function validDraft(d) {
      return d is map && d.keys().hasOnly(['name', 'exercises', 'description'])
        && d.name is string && d.name.size() >= 2 && d.name.size() <= 80 && validExercises(d.exercises)
        && d.get('description', '') is string && d.get('description', '').size() <= 300;
    }
    // O aluno só lê a VERSÃO que lhe foi atribuída (publicar uma versão nova não muda nem expõe nada para ele).
    function acReadsVersion(aid, versionId) {
      return acActive(aid) && (acRole(aid) in ['owner', 'admin', 'teacher']
        || (acRole(aid) == 'student' && exists(acAssignedTrainingPath(aid, request.auth.uid))
          && get(acAssignedTrainingPath(aid, request.auth.uid)).data.versionId == versionId));
    }

    // Ficha da academia: nasce RASCUNHO (currentVersion 0, sem versão). Editar muda só o rascunho. Publicar cria a versão imutável
    // idêntica ao rascunho e sobe currentVersion em 1. Só rascunho nunca publicado pode ser excluído. Tudo auditado no mesmo lote.
    match /trainingSeries/{seriesId} {
      // O documento carrega o RASCUNHO: o aluno não lê a série (só a versão atribuída, em trainingVersions).
      allow get: if signedIn() && (isAdmin() || (resource != null && acActive(resource.data.academyId) && acRole(resource.data.academyId) in ['owner', 'admin', 'teacher']));
      allow list: if signedIn() && (isAdmin() || (acActive(resource.data.academyId) && acRole(resource.data.academyId) in ['owner', 'admin', 'teacher']));
      allow create: if signedIn() && request.resource.data.keys().hasOnly(['academyId', 'name', 'currentVersion', 'status', 'draft', 'sourceTemplateId', 'sourceSeriesId', 'createdBy', 'auditId', 'createdAt', 'updatedAt'])
        && request.resource.data.get('sourceTemplateId', '') is string && request.resource.data.get('sourceTemplateId', '').size() <= 60
        // duplicada de outra ficha: a origem precisa ser da MESMA academia (a ficha de outra academia nem pode ser lida)
        && request.resource.data.get('sourceSeriesId', '') is string && request.resource.data.get('sourceSeriesId', '').matches('^[A-Za-z0-9_]{0,40}$')
        && (request.resource.data.get('sourceSeriesId', '') == ''
          || get(/databases/$(database)/documents/trainingSeries/$(request.resource.data.get('sourceSeriesId', ''))).data.academyId == request.resource.data.academyId)
        && acCanAuthor(request.resource.data.academyId) && request.resource.data.createdBy == request.auth.uid
        && validDraft(request.resource.data.draft) && request.resource.data.name == request.resource.data.draft.name
        && request.resource.data.currentVersion == 0 && request.resource.data.status == 'active'
        && request.resource.data.createdAt is string && request.resource.data.updatedAt is string
        && acLogged(request.resource.data.academyId, request.resource.data.auditId, 'training.created', seriesId);
      allow update: if signedIn() && acCanAuthor(resource.data.academyId) && request.resource.data.academyId == resource.data.academyId
        && request.resource.data.createdBy == resource.data.createdBy
        && (
          // editar o rascunho (ficha arquivada não se edita: restaure antes)
          (resource.data.status == 'active'
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['draft', 'name', 'updatedAt', 'auditId'])
            && request.resource.data.updatedAt is string
            && request.resource.data.currentVersion == resource.data.currentVersion
            && validDraft(request.resource.data.draft) && request.resource.data.name == request.resource.data.draft.name
            && acLogged(resource.data.academyId, request.resource.data.auditId, 'training.updated', seriesId))
          // publicar: a versão nova é exatamente o rascunho
          || (resource.data.status == 'active'
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['currentVersion', 'updatedAt', 'auditId'])
            && request.resource.data.updatedAt is string
            && request.resource.data.currentVersion == resource.data.currentVersion + 1
            && resource.data.draft.exercises.size() >= 1
            && existsAfter(acTrainingVersionPath(seriesId, request.resource.data.currentVersion))
            && getAfter(acTrainingVersionPath(seriesId, request.resource.data.currentVersion)).data.exercises == resource.data.draft.exercises
            && getAfter(acTrainingVersionPath(seriesId, request.resource.data.currentVersion)).data.name == resource.data.draft.name
            && getAfter(acTrainingVersionPath(seriesId, request.resource.data.currentVersion)).data.get('description', '') == resource.data.draft.get('description', '')
            && acLogged(resource.data.academyId, request.resource.data.auditId, 'training.published', seriesId))
          // arquivar / restaurar: só troca o status. Versões e atribuições existentes não mudam (o aluno segue com a versão que usa).
          || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'updatedAt', 'auditId'])
            && request.resource.data.updatedAt is string
            && ((resource.data.status == 'active' && request.resource.data.status == 'archived')
              || (resource.data.status == 'archived' && request.resource.data.status == 'active'))
            && acLogged(resource.data.academyId, request.resource.data.auditId,
              request.resource.data.status == 'archived' ? 'training.archived' : 'training.restored', seriesId))
        );
      // Só rascunho nunca publicado (sem versões, logo sem uso). A auditoria usa o ID fixo del_<fichaId>.
      allow delete: if signedIn() && acCanAuthor(resource.data.academyId) && resource.data.currentVersion == 0
        && acLogged(resource.data.academyId, 'del_' + seriesId, 'training.deleted', seriesId);
    }

    // Modelos OFICIAIS globais (scope 'official'): só o admin da plataforma cria e mantém; qualquer usuário logado lê.
    // A academia copia o modelo para uma ficha própria (trainingSeries, rascunho versionado) e nunca altera o original.
    match /trainingTemplates/{templateId} {
      allow get, list: if signedIn();
      allow create, update: if isAdmin()
        && request.resource.data.keys().hasOnly(['scope', 'order', 'focus', 'name', 'description', 'exercises', 'updatedAt', 'updatedBy'])
        && request.resource.data.scope == 'official'
        && request.resource.data.name is string && request.resource.data.name.size() >= 2 && request.resource.data.name.size() <= 80
        && request.resource.data.description is string && request.resource.data.description.size() <= 300
        && request.resource.data.focus in ['quadriceps', 'posterior', 'gluteos', 'panturrilhas', 'completo']
        && request.resource.data.order is int
        && validExercises(request.resource.data.exercises) && request.resource.data.exercises.size() >= 1;
      allow delete: if isAdmin();
    }

    match /trainingVersions/{versionId} {
      allow get: if signedIn() && (isAdmin() || (resource != null && acReadsVersion(resource.data.academyId, versionId)));
      allow list: if signedIn() && (isAdmin() || (acActive(resource.data.academyId) && acRole(resource.data.academyId) in ['owner', 'admin', 'teacher']));
      // Versão imutável: só nasce junto da publicação da série e nunca muda nem some.
      allow create: if signedIn() && request.resource.data.keys().hasOnly(['academyId', 'seriesId', 'version', 'name', 'description', 'exercises', 'createdBy', 'createdAt'])
        && request.resource.data.get('description', '') is string && request.resource.data.get('description', '').size() <= 300
        && request.resource.data.seriesId is string
        && versionId == request.resource.data.seriesId + '_' + string(request.resource.data.version)
        && request.resource.data.version is int && request.resource.data.version >= 1
        && acCanAuthor(request.resource.data.academyId) && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.name is string && request.resource.data.name.size() >= 2 && request.resource.data.name.size() <= 80
        && validExercises(request.resource.data.exercises) && request.resource.data.exercises.size() >= 1
        && existsAfter(/databases/$(database)/documents/trainingSeries/$(request.resource.data.seriesId))
        && getAfter(/databases/$(database)/documents/trainingSeries/$(request.resource.data.seriesId)).data.academyId == request.resource.data.academyId
        && getAfter(/databases/$(database)/documents/trainingSeries/$(request.resource.data.seriesId)).data.currentVersion == request.resource.data.version
        && getAfter(/databases/$(database)/documents/trainingSeries/$(request.resource.data.seriesId)).data.draft.exercises == request.resource.data.exercises
        && getAfter(/databases/$(database)/documents/trainingSeries/$(request.resource.data.seriesId)).data.draft.name == request.resource.data.name
        && getAfter(/databases/$(database)/documents/trainingSeries/$(request.resource.data.seriesId)).data.draft.get('description', '') == request.resource.data.get('description', '');
      allow update, delete: if false;
    }

    // Uma ficha por aluno (a nova atribuição substitui a anterior). Guarda a VERSÃO exata (versionId) e só aceita versão publicada.
    match /academyAssigned/{assignedId} {
      allow get: if signedIn() && (isAdmin() || (resource == null
        ? assignedId.matches('^[a-z0-9]{16,28}_' + request.auth.uid + '$')
        : (resource.data.studentId == request.auth.uid || resource.data.teacherId == request.auth.uid || acStaff(resource.data.academyId))));
      allow list: if signedIn() && (isAdmin() || resource.data.studentId == request.auth.uid
        || resource.data.teacherId == request.auth.uid || acStaff(resource.data.academyId));
      allow create, update: if signedIn() && request.resource.data.keys().hasOnly(['academyId', 'studentId', 'seriesId', 'version', 'versionId', 'teacherId', 'assignedBy', 'auditId', 'updatedAt'])
        && assignedId == request.resource.data.academyId + '_' + request.resource.data.studentId
        && request.resource.data.assignedBy == request.auth.uid
        && acIsStudent(request.resource.data.academyId, request.resource.data.studentId)
        && (acStaff(request.resource.data.academyId) || acTeacherOf(request.resource.data.academyId, request.resource.data.studentId))
        && request.resource.data.seriesId is string && request.resource.data.version is int
        && request.resource.data.versionId == request.resource.data.seriesId + '_' + string(request.resource.data.version)
        && get(acTrainingVersionPath(request.resource.data.seriesId, request.resource.data.version)).data.academyId == request.resource.data.academyId
        // ficha arquivada não recebe novas atribuições (quem já usa a versão continua com ela)
        && get(/databases/$(database)/documents/trainingSeries/$(request.resource.data.seriesId)).data.status == 'active'
        && request.resource.data.teacherId is string
        && (!exists(acAssignPath(request.resource.data.academyId, request.resource.data.studentId))
          || get(acAssignPath(request.resource.data.academyId, request.resource.data.studentId)).data.status != 'active'
          ? request.resource.data.teacherId == ''
          : get(acAssignPath(request.resource.data.academyId, request.resource.data.studentId)).data.teacherId == request.resource.data.teacherId)
        && acLogged(request.resource.data.academyId, request.resource.data.auditId, 'training.assigned', request.resource.data.studentId);
      allow delete: if signedIn() && (acStaff(resource.data.academyId) || acTeacherOf(resource.data.academyId, resource.data.studentId));
    }

    // All unmatched paths, including legacy users/{uid}/checkIns, stay denied.
  }
}
