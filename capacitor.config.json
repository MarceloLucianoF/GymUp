{
  "appId": "dev.marcelolabs.bohtreinar",
  "appName": "BohTreinar",
  "webDir": "mobile-shell",
  "server": {
    "url": "https://bohtreinar.marcelo-labs.workers.dev",
    "androidScheme": "https",
    "cleartext": false,
    "errorPath": "index.html"
  },
  "android": {
    "appendUserAgent": "BohTreinarApp/1"
  },
  "plugins": {
    "FirebaseAuthentication": {
      "skipNativeAuth": true,
      "providers": ["google.com"]
    },
    "PushNotifications": {
      "presentationOptions": ["badge", "sound", "alert"]
    }
  }
}
